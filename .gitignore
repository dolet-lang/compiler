# Build artifacts. pipeline_build.dlt is the single tracked self-hosted stage;
# everything else under build/ is disposable compiler/toolchain output.
/build/*
!/build/pipeline_build.dlt

# Intermediate compiler output
*.mlir
*.ll
*.obj
*.exe
!bin/doletc.exe
!bin/doletc

# Host toolchain executables are installed per machine. Manifests stay tracked.
toolchains/**/hosts/**/bin/*
toolchains/**/hosts/**/lib/*
toolchains/**/hosts/**/libexec/*
toolchains/**/hosts/**/bundle.toml

# Cloned repos (users add these manually, NOT part of this repo)
/bootstrap/
/tools/*
!/tools/README.md
!/tools/setup_tools.bat
!/tools/setup_tools.sh
!/scripts/stage_linux_host_tools.py
/library/
/packages/
/dist/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.bak

# OS
Thumbs.db
.DS_Store

#others
COMPILER_FIXES.md
DOLET_LANGUAGE_FEATURES.md
FUTURE_FEATURES.md

