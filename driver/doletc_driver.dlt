##############################
# Dolet Compiler CLI Driver
# Reads .dlt file, tokenizes, parses, generates MLIR, writes .mlir file
# Uses the host platform runtime for files/processes while the selected
# target pack supplies the runtime and linker contract for emitted programs.
##############################
"""
   ██████╗  ██████╗ ██╗     ███████╗████████╗
   ██╔══██╗██╔═══██╗██║     ██╔════╝╚══██╔══╝
   ██║  ██║██║   ██║██║     █████╗     ██║   
   ██║  ██║██║   ██║██║     ██╔══╝     ██║   
   ██████╔╝╚██████╔╝███████╗███████╗   ██║   
   ╚═════╝  ╚═════╝ ╚══════╝╚══════╝   ╚═╝  
"""
# ==========================================
# File I/O (using FileOps library)
# ==========================================
fun read_file_to_string(path: str) -> str:
    handle: i64 = FileOps.file_open_read(path)
    if handle == -1:
        return ""
    buf: i64 = FileOps.file_read_all(handle)
    FileOps.file_close(handle)
    if buf == 0:
        return ""
    return buf as str

fun write_string_to_file(path: str, content: str) -> i32:
    handle: i64 = FileOps.file_open_write(path)
    if handle == -1:
        return 0
    FileOps.file_write_str(handle, content)
    FileOps.file_close(handle)
    return 1

# ==========================================
# Path Helpers
# ==========================================
fun replace_extension(path: str, new_ext: str) -> str:
    slen: i64 = Memory.strlen(path)
    # Find last '.'
    dot_pos: i64 = -1
    i: i64 = slen - 1
    c: i8 = 0 as i8
    while i >= 0:
        c = Memory.read_i8((path as i64) + i)
        if c == 46:
            dot_pos = i
            break
        if c == 92 or c == 47:
            break
        i = i - 1

    base: str = path
    if dot_pos >= 0:
        base = str_from_range(path, 0 as i64, dot_pos)
    return Str.concat(base, new_ext)

# ==========================================
# Platform Config
# ==========================================
# Reads a target pack's Platform Manifest (platform.toml) at startup.
# Manifest v3 carries only platform-neutral identity and ABI facts. Backend
# spellings belong to the selected toolchain adapter, never to a Dolet target
# or application manifest.
# The compiler itself knows NO platform names — just the target contract.
# ==========================================
g_host_separator: str = ""
g_plat_schema: str = ""
g_plat_id: str = ""
g_plat_os: str = ""
g_plat_arch: str = ""
g_plat_abi: str = ""
g_plat_runtime: str = ""
g_plat_object_format: str = ""
g_plat_executable_format: str = ""
g_plat_module_root: str = ""
g_plat_registry: str = ""
g_plat_manifest_path: str = ""
g_plat_required_capabilities: str = ""
g_plat_toolchain_id: str = ""
g_plat_toolchain_version: str = ""
g_plat_translate: str = ""
g_plat_compile: str = ""
g_plat_linker: str = ""
g_plat_obj_ext: str = ""
g_plat_exe_ext: str = ""
g_backend_codegen_target: str = ""
g_plat_default_libs: str = ""
g_plat_provided_libs: str = ""
g_plat_runtime_helpers: str = ""
g_plat_pre_objects: str = ""
g_plat_post_objects: str = ""
g_plat_link_options: str = ""
g_plat_sys_path: str = ""
g_plat_dynamic_for_libs: str = ""
g_plat_dynamic_default_libs: str = ""
g_plat_dynamic_runtime_helpers: str = ""
g_plat_dynamic_pre_objects: str = ""
g_plat_dynamic_post_objects: str = ""
g_plat_dynamic_link_options: str = ""
g_plat_dynamic_sys_path: str = ""
g_plat_dynamic_entry: str = ""
g_plat_stack_size: str = ""
g_plat_entry: str = ""
g_plat_flag_output: str = ""
g_plat_flag_libpath: str = ""
g_plat_flag_defaultlib: str = ""
g_plat_flag_subsystem_console: str = ""
g_plat_flag_subsystem_gui: str = ""
g_plat_flag_entry: str = ""
g_plat_flag_stack: str = ""
g_plat_flag_deterministic: str = ""
g_plat_flag_link_target: str = ""
g_plat_name: str = ""
g_package_paths: i64 = 0
g_resolved_package_dirs: i64 = 0

fun register_resolved_package_dir(directory: str):
    if g_resolved_package_dirs == 0 or Memory.strlen(directory) == 0:
        return
    index: i32 = 0
    while index < nl_count(g_resolved_package_dirs):
        if str_eq(nl_get(g_resolved_package_dirs, index) as str, directory) == 1:
            return
        index = index + 1
    nl_add(g_resolved_package_dirs, directory as i64)

