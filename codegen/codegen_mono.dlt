# Monomorphization for user-defined generics (B3 Phase 2 — minimal MVP)

g_mono_names: i64 = 0
g_mono_count: i32 = 0

# Phase 4.5: Generic-function registry. Filled by collect_declarations
# when it encounters NODE_FUN_DEF with type_params != 0.
g_gen_fn_names: i64 = 0
g_gen_fn_nodes: i64 = 0
g_gen_fn_count: i32 = 0

# Per-function variable-type scope, used while mono_walk descends a
# function body so a generic INSTANCE method call `obj.method<T>(...)`
# can resolve `obj`'s struct type. Flat (no block scoping) and reset
# at every NODE_FUN_DEF — a var name within one function has one type.
g_mvt_names: i64 = 0
g_mvt_types: i64 = 0
g_mvt_count: i32 = 0

fun mvt_alloc():
    if g_mvt_names == 0:
        g_mvt_names = Memory.malloc_zeroed(4096 * 8)
        g_mvt_types = Memory.malloc_zeroed(4096 * 8)

fun mvt_reset():
    mvt_alloc()
    g_mvt_count = 0

fun mvt_add(name: str, vtype: str):
    # Lazy-alloc — top-level var-decls reach mvt_add before any
    # enclosing NODE_FUN_DEF has called mvt_reset.
    mvt_alloc()
    if g_mvt_count >= 4096:
        return
    off: i64 = (g_mvt_count as i64) * 8
    Memory.write_i64(g_mvt_names + off, name as i64)
    Memory.write_i64(g_mvt_types + off, vtype as i64)
    g_mvt_count = g_mvt_count + 1

# Returns the registered type for `name`, or "" if unknown. Last
# write wins (a later var-decl shadows an earlier same-named one).
fun mvt_lookup(name: str) -> str:
    i: i32 = g_mvt_count - 1
    while i >= 0:
        off: i64 = (i as i64) * 8
        if str_eq(Memory.read_i64(g_mvt_names + off) as str, name) == 1:
            return Memory.read_i64(g_mvt_types + off) as str
        i = i - 1
    return ""

fun init_gen_fn_registry():
    g_gen_fn_names = Memory.malloc_zeroed(8192)
    g_gen_fn_nodes = Memory.malloc_zeroed(8192)
    g_gen_fn_count = 0

fun register_gen_fn(name: str, node: i64):
    Memory.write_i64(g_gen_fn_names + ((g_gen_fn_count as i64) * 8), name as i64)
    Memory.write_i64(g_gen_fn_nodes + ((g_gen_fn_count as i64) * 8), node)
    g_gen_fn_count = g_gen_fn_count + 1

fun is_generic_fn(name: str) -> i32:
    i: i32 = 0
    while i < g_gen_fn_count:
        if str_eq(Memory.read_i64(g_gen_fn_names + ((i as i64) * 8)) as str, name) == 1:
            return 1
        i = i + 1
    return 0

fun find_gen_fn_node(name: str) -> i64:
    i: i32 = 0
    while i < g_gen_fn_count:
        if str_eq(Memory.read_i64(g_gen_fn_names + ((i as i64) * 8)) as str, name) == 1:
            return Memory.read_i64(g_gen_fn_nodes + ((i as i64) * 8))
        i = i + 1
    return 0

fun init_mono_registry():
    g_mono_names = Memory.malloc_zeroed(8192)
    g_mono_count = 0
    # Note: init_gen_fn_registry is called from init_all_registries
    # before collect_declarations populates it — DON'T re-init here.

fun mono_done(c: str) -> i32:
    i: i32 = 0
    while i < g_mono_count:
        if str_eq(Memory.read_i64(g_mono_names + ((i as i64) * 8)) as str, c) == 1:
            return 1
        i = i + 1
    return 0

fun mono_record(c: str):
    Memory.write_i64(g_mono_names + ((g_mono_count as i64) * 8), c as i64)
    g_mono_count = g_mono_count + 1

fun mono_id(c: i8) -> i32:
    if c >= 65 as i8 and c <= 90 as i8:
        return 1
    if c >= 97 as i8 and c <= 122 as i8:
        return 1
    if c >= 48 as i8 and c <= 57 as i8:
        return 1
    if c == 95 as i8:
        return 1
    return 0

fun substitute_type(t: str, tn: str, conc: str) -> str:
    n: i64 = Memory.strlen(t)
    tnl: i64 = Memory.strlen(tn)
    if tnl == 0 as i64:
        return t
    out: str = ""
    i: i64 = 0
    while i < n:
        m: i32 = 0
        if i + tnl <= n:
            j: i64 = 0
            ok: i32 = 1
            while j < tnl:
                if char_at(t, i + j) != char_at(tn, j):
                    ok = 0
                    j = tnl
                j = j + 1 as i64
            if ok == 1:
                lok: i32 = 1
                rok: i32 = 1
                if i > 0 as i64:
                    if mono_id(char_at(t, i - 1 as i64)) == 1:
                        lok = 0
                if i + tnl < n:
                    if mono_id(char_at(t, i + tnl)) == 1:
                        rok = 0
                if lok == 1 and rok == 1:
                    m = 1
        if m == 1:
            out = Str.concat(out, conc)
            i = i + tnl
        else:
            cb: i64 = Memory.malloc(2 as i64)
            Memory.write_i8(cb, char_at(t, i))
            Memory.write_i8(cb + 1 as i64, 0 as i8)
            out = Str.concat(out, cb as str)
            i = i + 1 as i64
    return out

fun canon_if_gen(t: str) -> str:
    if (t as i64) == 0:
        return t
    op: i64 = Str.index_of(t, "[")
    if op <= 0 as i64:
        return t
    outer: str = Str.substring(t, 0 as i64, op)
    if is_generic_type(outer) == 0:
        return t
    ep: i64 = Memory.strlen(t) - 1 as i64
    inner: str = Str.substring(t, op + 1 as i64, ep)
    flat: str = Str.replace(Str.replace(Str.replace(inner, "[", "_"), "]", ""), ",", "_")
    return Str.concat(Str.concat(outer, "__"), flat)

fun find_gen_struct(ast: i64, name: str) -> i64:
    c: i32 = nl_count(ast)
    i: i32 = 0
    while i < c:
        nd: i64 = nl_get(ast, i)
        if nd_type(nd) == NODE_STRUCT_DECL:
            if str_eq(Memory.read_i64(nd + 8) as str, name) == 1:
                return nd
        i = i + 1
    return 0

fun clone_gen_struct(orig: i64, types: i64, canon: str) -> i64:
    of: i64 = Memory.read_i64(orig + 16)
    tp: i64 = Memory.read_i64(orig + 24)
    pc: i32 = 0
    if tp != 0:
        pc = nl_count(tp)
    nf: i64 = mk_node_list(16)
    if of != 0:
        fc: i32 = nl_count(of)
        fi: i32 = 0
        while fi < fc:
            fn: i64 = nl_get(of, fi)
            ft: str = Memory.read_i64(fn + 16) as str
            nt: str = ft
            pi: i32 = 0
            while pi < pc:
                tp_item: i64 = nl_get(tp, pi)
                tnam: str = Memory.read_i64(tp_item + 0) as str
                if pi < nl_count(types):
                    ct: str = nl_get(types, pi) as str
                    nt = substitute_type(nt, tnam, ct)
                pi = pi + 1
            nfd: i64 = mk_struct_field(Memory.read_i64(fn + 8) as str, nt, Memory.read_i64(fn + 24), Memory.read_i64(fn + 32), Memory.read_i64(fn + 40) as str, Memory.read_i64(fn + 48))
            nl_add(nf, nfd)
            fi = fi + 1
    ns: i64 = mk_struct_decl(canon, nf, 0, "", 0, 0, 0, 0)
    register_struct(canon, nf)
    return ns

# Phase 3.5: Substitute T-references in a single statement node.
# Returns a new node when type substitution is needed (so the
# original body shared across instantiations stays untouched), or
# the same node otherwise. Recurses into containers.
fun subst_stmt(node: i64, tp: i64, types: i64) -> i64:
    if node == 0:
        return 0
    nt: i32 = nd_type(node)
    pc: i32 = 0
    if tp != 0:
        pc = nl_count(tp)

    if nt == NODE_VAR_DECL:
        vt: str = Memory.read_i64(node + 8) as str
        new_vt: str = vt
        si: i32 = 0
        while si < pc:
            tp_it: i64 = nl_get(tp, si)
            tn: str = Memory.read_i64(tp_it + 0) as str
            if si < nl_count(types):
                ct: str = nl_get(types, si) as str
                new_vt = substitute_type(new_vt, tn, ct)
            si = si + 1
        # Recurse into the initializer — it may itself be `T.method(...)`.
        old_init: i64 = Memory.read_i64(node + 24)
        new_init: i64 = subst_stmt(old_init, tp, types)
        if str_eq(new_vt, vt) == 0 or new_init != old_init:
            # Allocate a fresh NODE_VAR_DECL with substituted type/init
            nn: i64 = mk_var_decl(new_vt, Memory.read_i64(node + 16) as str, new_init, Memory.read_i64(node + 32), Memory.read_i64(node + 48), Memory.read_i64(node + 56))
            return nn
        return node

    # A static method call whose RECEIVER is a type-param: `T.build(...)`.
    # Inside a generic body, `T` must become the concrete type so the
    # codegen mangler lands on `Concrete_build`. Receiver is always a
    # bare type name, so match it exactly against each type-param.
    if nt == NODE_STATIC_METHOD:
        sm_recv: str = Memory.read_i64(node + 8) as str
        sm_new: str = sm_recv
        smi: i32 = 0
        while smi < pc:
            tp_itS: i64 = nl_get(tp, smi)
            tnS: str = Memory.read_i64(tp_itS + 0) as str
            if smi < nl_count(types):
                ctS: str = nl_get(types, smi) as str
                if str_eq(sm_recv, tnS) == 1:
                    sm_new = ctS
            smi = smi + 1
        if str_eq(sm_new, sm_recv) == 0:
            nsm: i64 = mk_static_method(sm_new, Memory.read_i64(node + 16) as str, Memory.read_i64(node + 24))
            Memory.write_i64(nsm + 32, Memory.read_i64(node + 32))
            return nsm
        return node

    if nt == NODE_CAST:
        ct_str: str = Memory.read_i64(node + 16) as str
        new_ct: str = ct_str
        si2: i32 = 0
        while si2 < pc:
            tp_it2: i64 = nl_get(tp, si2)
            tn2: str = Memory.read_i64(tp_it2 + 0) as str
            if si2 < nl_count(types):
                ct2: str = nl_get(types, si2) as str
                new_ct = substitute_type(new_ct, tn2, ct2)
            si2 = si2 + 1
        if str_eq(new_ct, ct_str) == 0:
            return mk_cast(Memory.read_i64(node + 8), new_ct)
        return node

    # Phase 4.5: fun_call may contain T in type_args list.
    # Substitute each type_arg string in place (the list itself is
    # cloned-on-write because the same node may also be reachable
    # via the original generic body).
    if nt == NODE_FUN_CALL:
        old_ta: i64 = Memory.read_i64(node + 24)
        if old_ta != 0:
            tac: i32 = nl_count(old_ta)
            new_ta: i64 = mk_node_list(8)
            ta_changed: i32 = 0
            ai: i32 = 0
            while ai < tac:
                old_t: str = nl_get(old_ta, ai) as str
                new_t: str = old_t
                psi: i32 = 0
                while psi < pc:
                    tp_itX: i64 = nl_get(tp, psi)
                    tnX: str = Memory.read_i64(tp_itX + 0) as str
                    if psi < nl_count(types):
                        ctX: str = nl_get(types, psi) as str
                        new_t = substitute_type(new_t, tnX, ctX)
                    psi = psi + 1
                if str_eq(new_t, old_t) == 0:
                    ta_changed = 1
                nl_add(new_ta, new_t as i64)
                ai = ai + 1
            if ta_changed == 1:
                # Build a new fun_call sharing same args list
                new_call: i64 = mk_fun_call(Memory.read_i64(node + 8) as str, Memory.read_i64(node + 16), new_ta)
                return new_call
        return node

    if nt == NODE_RETURN:
        v: i64 = Memory.read_i64(node + 8)
        nv: i64 = subst_stmt(v, tp, types)
        if nv != v:
            return mk_return(nv)
        return node
    if nt == NODE_IF:
        return node
    if nt == NODE_WHILE:
        return node
    if nt == NODE_BLOCK:
        return node
    return node

# Walk a body statement list and substitute T in each statement.
# Returns either the original list (if no substitutions needed) or
# a new list with substituted statements.
fun subst_body(body: i64, tp: i64, types: i64) -> i64:
    if body == 0:
        return 0
    c: i32 = nl_count(body)
    new_body: i64 = mk_node_list(16)
    changed: i32 = 0
    i: i32 = 0
    while i < c:
        old: i64 = nl_get(body, i)
        new: i64 = subst_stmt(old, tp, types)
        if new != old:
            changed = 1
        nl_add(new_body, new)
        i = i + 1
    if changed == 1:
        return new_body
    return body

# Phase 3: Clone an extend-block method for the monomorphized struct.
# Substitutes type-param names in param types, return type, and (B3.5)
# in any var-decl/cast types inside the body.
fun clone_method_subst(orig: i64, tp: i64, types: i64) -> i64:
    pc: i32 = 0
    if tp != 0:
        pc = nl_count(tp)
    op: i64 = Memory.read_i64(orig + 16)
    np: i64 = mk_node_list(8)
    if op != 0:
        ppc: i32 = nl_count(op)
        ppi: i32 = 0
        while ppi < ppc:
            opn: i64 = nl_get(op, ppi)
            opt: str = Memory.read_i64(opn + 16) as str
            nt: str = opt
            si: i32 = 0
            while si < pc:
                tp_it: i64 = nl_get(tp, si)
                tn: str = Memory.read_i64(tp_it + 0) as str
                if si < nl_count(types):
                    ct: str = nl_get(types, si) as str
                    nt = substitute_type(nt, tn, ct)
                si = si + 1
            nl_add(np, mk_param(Memory.read_i64(opn + 8) as str, nt, Memory.read_i64(opn + 24)))
            ppi = ppi + 1
    orig_ret: str = Memory.read_i64(orig + 24) as str
    nret: str = orig_ret
    si2: i32 = 0
    while si2 < pc:
        tp_it2: i64 = nl_get(tp, si2)
        tn2: str = Memory.read_i64(tp_it2 + 0) as str
        if si2 < nl_count(types):
            ct2: str = nl_get(types, si2) as str
            nret = substitute_type(nret, tn2, ct2)
        si2 = si2 + 1
    # Phase 3.5: clone body with T substituted in var-decl/cast types
    new_body: i64 = subst_body(Memory.read_i64(orig + 32), tp, types)
    return mk_method_def(Memory.read_i64(orig + 8) as str, np, nret, new_body, Memory.read_i64(orig + 40), Memory.read_i64(orig + 48) as str, Memory.read_i64(orig + 56), Memory.read_i64(orig + 64))

# Build param-types str from method params (skipping self) — for overload registry.
fun method_pt_str(params: i64) -> str:
    if params == 0:
        return ""
    out: str = ""
    pc: i32 = nl_count(params)
    i: i32 = 0
    while i < pc:
        pn: i64 = nl_get(params, i)
        nm: str = Memory.read_i64(pn + 8) as str
        if str_eq(nm, "self") == 0:
            tp: str = Memory.read_i64(pn + 16) as str
            if Memory.strlen(out) > 0:
                out = Str.concat(out, Str.concat(",", tp))
            else:
                out = tp
        i = i + 1
    return out

# Clone all extend blocks for `base` struct, retargeting to `canonical`.
# Substitutes T with concrete types; registers methods with codegen.
fun clone_extends_for_mono(ast: i64, base: str, canonical: str, struct_tp: i64, types: i64):
    c: i32 = nl_count(ast)
    i: i32 = 0
    while i < c:
        node: i64 = nl_get(ast, i)
        nt: i32 = nd_type(node)
        if nt == NODE_EXTEND_BLOCK:
            tname: str = Memory.read_i64(node + 8) as str
            if str_eq(tname, base) == 1:
                methods: i64 = Memory.read_i64(node + 16)
                nm: i64 = mk_node_list(8)
                if methods != 0:
                    mc: i32 = nl_count(methods)
                    mi: i32 = 0
                    while mi < mc:
                        old_m: i64 = nl_get(methods, mi)
                        new_m: i64 = clone_method_subst(old_m, struct_tp, types)
                        nl_add(nm, new_m)
                        mname: str = Memory.read_i64(new_m + 8) as str
                        mret: str = Memory.read_i64(new_m + 24) as str
                        mb: str = Str.concat(Str.concat(canonical, "_"), mname)
                        pts: str = method_pt_str(Memory.read_i64(new_m + 16))
                        mangled: str = register_overload(mb, pts)
                        register_fun_sig_with_params(mangled, mret, pts)
                        register_impl_method(canonical, mname, new_m)
                        mi = mi + 1
                ne: i64 = mk_extend_block(canonical, nm, 0)
                nl_add(ast, ne)
        i = i + 1

# Phase 4: Look up a trait declaration in the AST by name.
fun find_trait_decl(ast: i64, name: str) -> i64:
    c: i32 = nl_count(ast)
    i: i32 = 0
    while i < c:
        node: i64 = nl_get(ast, i)
        if nd_type(node) == NODE_TRAIT_DECL:
            if str_eq(Memory.read_i64(node + 8) as str, name) == 1:
                return node
        i = i + 1
    return 0

# Phase 4: Verify that for each `<T: Bound>` type-param, the matching
# concrete type implements every method declared on the bound trait.
# Panics with a clear file:line-style message on violation.
fun check_bounds(ast: i64, base: str, tp: i64, types: i64):
    if tp == 0:
        return
    pc: i32 = nl_count(tp)
    pi: i32 = 0
    while pi < pc:
        item: i64 = nl_get(tp, pi)
        bound: str = Memory.read_i64(item + 8) as str
        if (bound as i64) != 0 and Memory.strlen(bound) > 0:
            if pi < nl_count(types):
                ct: str = nl_get(types, pi) as str
                trait_node: i64 = find_trait_decl(ast, bound)
                if trait_node == 0:
                    panic(Str.concat(Str.concat(Str.concat("trait '", bound), "' not found (referenced as bound on '"), Str.concat(base, "')")))
                # Check each trait method exists as impl on ct
                methods: i64 = Memory.read_i64(trait_node + 16)
                if methods != 0:
                    mc: i32 = nl_count(methods)
                    mi: i32 = 0
                    while mi < mc:
                        mnode: i64 = nl_get(methods, mi)
                        mname: str = Memory.read_i64(mnode + 8) as str
                        if find_impl_method(ct, mname) == 0:
                            msg: str = Str.concat("type '", ct)
                            msg = Str.concat(msg, "' does not implement trait '")
                            msg = Str.concat(msg, bound)
                            msg = Str.concat(msg, "': missing method '")
                            msg = Str.concat(msg, mname)
                            msg = Str.concat(msg, "'")
                            panic(msg)
                        mi = mi + 1
        pi = pi + 1

# Phase 4b: Validate explicit `attach Trait for Type:` declarations.
# For every such block (NODE_EXTEND_BLOCK with a trait name recorded
# at +32), every method the trait declares must be implemented on
# Type. Runs after collect_declarations so the impl registry is fully
# populated. Catches missing-method errors even when the trait is
# never used as a generic bound.
fun check_explicit_trait_impls(ast: i64):
    c: i32 = nl_count(ast)
    i: i32 = 0
    while i < c:
        node: i64 = nl_get(ast, i)
        if nd_type(node) == NODE_EXTEND_BLOCK:
            tname_raw: i64 = Memory.read_i64(node + 32)
            if tname_raw != 0:
                trait_name: str = tname_raw as str
                if Memory.strlen(trait_name) > 0:
                    type_name: str = Memory.read_i64(node + 8) as str
                    trait_node: i64 = find_trait_decl(ast, trait_name)
                    if trait_node == 0:
                        panic(Str.concat(Str.concat(Str.concat("trait '", trait_name), "' not found (referenced in `attach "), Str.concat(Str.concat(trait_name, " for "), Str.concat(type_name, ":`)"))))
                    tmethods: i64 = Memory.read_i64(trait_node + 16)
                    if tmethods != 0:
                        tmc: i32 = nl_count(tmethods)
                        tmi: i32 = 0
                        while tmi < tmc:
                            tm: i64 = nl_get(tmethods, tmi)
                            tmname: str = Memory.read_i64(tm + 8) as str
                            if find_impl_method(type_name, tmname) == 0:
                                em: str = Str.concat("type '", type_name)
                                em = Str.concat(em, "' does not implement trait '")
                                em = Str.concat(em, trait_name)
                                em = Str.concat(em, "': missing method '")
                                em = Str.concat(em, tmname)
                                em = Str.concat(em, "'")
                                panic(em)
                            tmi = tmi + 1
        i = i + 1

fun mono_ensure(ast: i64, base: str, ta: i64) -> str:
    cnt: i32 = nl_count(ta)
    c: str = base
    i: i32 = 0
    while i < cnt:
        s: str = nl_get(ta, i) as str
        f: str = Str.replace(Str.replace(Str.replace(s, "[", "_"), "]", ""), ",", "_")
        if i == 0:
            c = Str.concat(Str.concat(c, "__"), f)
        else:
            c = Str.concat(Str.concat(c, "_"), f)
        i = i + 1
    if mono_done(c) == 0:
        o: i64 = find_gen_struct(ast, base)
        if o != 0:
            struct_tp: i64 = Memory.read_i64(o + 24)
            check_bounds(ast, base, struct_tp, ta)
            ns: i64 = clone_gen_struct(o, ta, c)
            nl_add(ast, ns)
            mono_record(c)
            clone_extends_for_mono(ast, base, c, struct_tp, ta)
    return c

# Minimal walker — covers the cases that matter for Box<i32>(...) usage:
# top-level statements (var_decl, return, expression), function bodies,
# and basic recursive forms (if/while/for_each/block/match).
fun mono_walk_list(ast: i64, nl: i64):
    if nl == 0:
        return
    c: i32 = nl_count(nl)
    i: i32 = 0
    while i < c:
        mono_walk_node(ast, nl_get(nl, i))
        i = i + 1

fun mono_walk_node(ast: i64, node: i64):
    if node == 0:
        return
    nt: i32 = nd_type(node)
    if nt == NODE_FUN_CALL:
        fname: str = Memory.read_i64(node + 8) as str
        ta: i64 = Memory.read_i64(node + 24)
        if ta != 0 and is_generic_type(fname) == 1:
            cn: str = mono_ensure(ast, fname, ta)
            Memory.write_i64(node + 8, cn as i64)
            Memory.write_i64(node + 24, 0)
        elif ta != 0 and is_generic_fn(fname) == 1:
            # Phase 4.5: Generic function call — clone the fn body
            # with T → concrete substituted in params, return type, and body.
            cn2: str = mono_ensure_fn(ast, fname, ta)
            Memory.write_i64(node + 8, cn2 as i64)
            Memory.write_i64(node + 24, 0)
        mono_walk_list(ast, Memory.read_i64(node + 16))
        return
    # Generic STATIC method call: `Type.method<T>(args)`. The type-arg
    # list lives at node+32. The method was registered as a generic fn
    # under key `Type_method`; mono_ensure_fn clones it to a concrete
    # top-level `Type_method__i32`, and we rewrite the method name so
    # the codegen mangler (`struct + "_" + method`) lands on that clone.
    if nt == NODE_STATIC_METHOD:
        sm_ta: i64 = Memory.read_i64(node + 32)
        if sm_ta != 0:
            sm_struct: str = Memory.read_i64(node + 8) as str
            sm_method: str = Memory.read_i64(node + 16) as str
            sm_key: str = Str.concat(Str.concat(sm_struct, "_"), sm_method)
            if is_generic_fn(sm_key) == 1:
                sm_canon: str = mono_ensure_fn(ast, sm_key, sm_ta)
                # Strip the `Type_` prefix: canon `Type_method__i32`
                # → method name `method__i32`.
                sm_pref: i64 = Memory.strlen(sm_struct) + 1 as i64
                sm_new_method: str = Str.substring(sm_canon, sm_pref, Memory.strlen(sm_canon))
                Memory.write_i64(node + 16, sm_new_method as i64)
                Memory.write_i64(node + 32, 0)
        mono_walk_list(ast, Memory.read_i64(node + 24))
        return
    # Generic INSTANCE method call: `obj.method<T>(args)`. `obj`'s
    # struct type is resolved from the per-function var-type scope
    # (mvt — populated from params + var-decls as mono_walk descends).
    # The generic method is cloned into the struct's attach block as
    # a concrete `method__T`, and the call's method name rewritten.
    if nt == NODE_INST_METHOD:
        im_ta: i64 = Memory.read_i64(node + 32)
        if im_ta != 0:
            im_obj: str = Memory.read_i64(node + 8) as str
            im_method: str = Memory.read_i64(node + 16) as str
            im_struct: str = mvt_lookup(im_obj)
            if str_eq(im_struct, "") == 1:
                panic(Str.concat(Str.concat("cannot resolve the type of '", im_obj), "' for a generic method call — give it an explicit declared type (`x: SomeStruct = ...`)"))
            im_key: str = Str.concat(Str.concat(im_struct, "_"), im_method)
            if is_generic_fn(im_key) == 1:
                im_new: str = mono_ensure_method(ast, im_struct, im_method, im_ta)
                Memory.write_i64(node + 16, im_new as i64)
                Memory.write_i64(node + 32, 0)
        mono_walk_list(ast, Memory.read_i64(node + 24))
        return
    # A method chain `recv.m()` — the receiver at +8 may itself be a
    # generic call (`app.spawn<Cube>().set_name(...)`). Without
    # descending here, generic calls buried inside a chain are never
    # monomorphized and the call site keeps the un-suffixed name.
    if nt == NODE_NESTED_METHOD:
        mono_walk_node(ast, Memory.read_i64(node + 8))
        mono_walk_list(ast, Memory.read_i64(node + 24))
        return

    if nt == NODE_VAR_DECL:
        vt: str = Memory.read_i64(node + 8) as str
        if (vt as i64) != 0:
            nv: str = canon_if_gen(vt)
            if str_eq(nv, vt) == 0:
                Memory.write_i64(node + 8, nv as i64)
        # Record var → struct type so a later `var.method<T>(...)` in
        # this function body can resolve the receiver.
        vd_name: str = Memory.read_i64(node + 16) as str
        vd_type: str = Memory.read_i64(node + 8) as str
        if (vd_type as i64) != 0 and Memory.strlen(vd_type) > 0:
            mvt_add(vd_name, vd_type)
        else:
            # Inferred type — if the initializer is a struct literal,
            # the literal's struct name is the variable's type.
            vd_val: i64 = Memory.read_i64(node + 24)
            if vd_val != 0:
                if nd_type(vd_val) == NODE_STRUCT_INST:
                    mvt_add(vd_name, Memory.read_i64(vd_val + 8) as str)
        mono_walk_node(ast, Memory.read_i64(node + 24))
        return
    if nt == NODE_FUN_DEF:
        # Skip generic functions — their body has unresolved T refs
        # which shouldn't be monomorphized until the function is
        # instantiated (which clones the body with T → concrete).
        ftp: i64 = Memory.read_i64(node + 40)
        if ftp != 0:
            return
        # Fresh var-type scope for this function — used so generic
        # instance method calls in the body can resolve `obj`'s type.
        mvt_reset()
        ps: i64 = Memory.read_i64(node + 16)
        if ps != 0:
            pc: i32 = nl_count(ps)
            pi: i32 = 0
            while pi < pc:
                pn: i64 = nl_get(ps, pi)
                pt: str = Memory.read_i64(pn + 16) as str
                if (pt as i64) != 0:
                    npt: str = canon_if_gen(pt)
                    if str_eq(npt, pt) == 0:
                        Memory.write_i64(pn + 16, npt as i64)
                    # Record param → type for instance-method resolution.
                    pn_name: str = Memory.read_i64(pn + 8) as str
                    mvt_add(pn_name, Memory.read_i64(pn + 16) as str)
                pi = pi + 1
        rt: str = Memory.read_i64(node + 24) as str
        if (rt as i64) != 0:
            nrt: str = canon_if_gen(rt)
            if str_eq(nrt, rt) == 0:
                Memory.write_i64(node + 24, nrt as i64)
        mono_walk_list(ast, Memory.read_i64(node + 32))
        return
    if nt == NODE_RETURN:
        mono_walk_node(ast, Memory.read_i64(node + 8))
        return
    if nt == NODE_ASSIGN or nt == NODE_FIELD_VAL:
        mono_walk_node(ast, Memory.read_i64(node + 16))
        return
    # NODE_FIELD_ASSIGN is `obj.field = value` — value is at +24
    # (obj@8, field@16). `flycam.camera = app.spawn<T>()...` lives here.
    if nt == NODE_FIELD_ASSIGN:
        mono_walk_node(ast, Memory.read_i64(node + 24))
        return
    if nt == NODE_NESTED_FIELD_ASSIGN:
        mono_walk_node(ast, Memory.read_i64(node + 8))
        mono_walk_node(ast, Memory.read_i64(node + 16))
        return
    if nt == NODE_BLOCK:
        mono_walk_list(ast, Memory.read_i64(node + 8))
        return
    if nt == NODE_IF:
        mono_walk_list(ast, Memory.read_i64(node + 16))
        mono_walk_list(ast, Memory.read_i64(node + 24))
        return
    if nt == NODE_WHILE:
        mono_walk_list(ast, Memory.read_i64(node + 16))
        return
    if nt == NODE_MATCH:
        mono_walk_list(ast, Memory.read_i64(node + 16))
        return

# Phase 4.5: clone a generic fun_def with T → concrete substituted
# in params, return type, and body (var-decls, casts).
fun clone_gen_fn(orig: i64, types: i64, canon: str) -> i64:
    tp: i64 = Memory.read_i64(orig + 40)
    pc: i32 = 0
    if tp != 0:
        pc = nl_count(tp)
    # Clone params
    op: i64 = Memory.read_i64(orig + 16)
    np: i64 = mk_node_list(8)
    if op != 0:
        ppc: i32 = nl_count(op)
        ppi: i32 = 0
        while ppi < ppc:
            opn: i64 = nl_get(op, ppi)
            opt: str = Memory.read_i64(opn + 16) as str
            nt2: str = opt
            si: i32 = 0
            while si < pc:
                tp_it: i64 = nl_get(tp, si)
                tn: str = Memory.read_i64(tp_it + 0) as str
                if si < nl_count(types):
                    ct: str = nl_get(types, si) as str
                    nt2 = substitute_type(nt2, tn, ct)
                si = si + 1
            nl_add(np, mk_param(Memory.read_i64(opn + 8) as str, nt2, Memory.read_i64(opn + 24)))
            ppi = ppi + 1
    # Substitute return type
    orig_ret: str = Memory.read_i64(orig + 24) as str
    nret: str = orig_ret
    si2: i32 = 0
    while si2 < pc:
        tp_it2: i64 = nl_get(tp, si2)
        tn2: str = Memory.read_i64(tp_it2 + 0) as str
        if si2 < nl_count(types):
            ct2: str = nl_get(types, si2) as str
            nret = substitute_type(nret, tn2, ct2)
        si2 = si2 + 1
    # Clone body with T substituted in var-decls/casts
    new_body: i64 = subst_body(Memory.read_i64(orig + 32), tp, types)
    # Build the fun_def with empty type_params (already monomorphized)
    new_fn: i64 = mk_fun_def(canon, np, nret, new_body, 0, Memory.read_i64(orig + 48), Memory.read_i64(orig + 56) as str, Memory.read_i64(orig + 64))
    # Register so codegen finds it
    pt_str: str = build_param_types_str(np)
    mangled: str = register_overload(canon, pt_str)
    register_fun_sig_with_params(mangled, nret, pt_str)
    return new_fn

# Phase 4.5: ensure generic-function instantiation exists.
fun mono_ensure_fn(ast: i64, base: str, ta: i64) -> str:
    cnt: i32 = nl_count(ta)
    c: str = base
    i: i32 = 0
    while i < cnt:
        s: str = nl_get(ta, i) as str
        f: str = Str.replace(Str.replace(Str.replace(s, "[", "_"), "]", ""), ",", "_")
        if i == 0:
            c = Str.concat(Str.concat(c, "__"), f)
        else:
            c = Str.concat(Str.concat(c, "_"), f)
        i = i + 1
    if mono_done(c) == 0:
        o: i64 = find_gen_fn_node(base)
        if o != 0:
            new_fn: i64 = clone_gen_fn(o, ta, c)
            nl_add(ast, new_fn)
            mono_record(c)
            mono_walk_list(ast, Memory.read_i64(new_fn + 32))
    return c

# Find the first `attach <name>:` block in the top-level AST.
fun find_extend_block(ast: i64, name: str) -> i64:
    c: i32 = nl_count(ast)
    i: i32 = 0
    while i < c:
        node: i64 = nl_get(ast, i)
        if nd_type(node) == NODE_EXTEND_BLOCK:
            if str_eq(Memory.read_i64(node + 8) as str, name) == 1:
                return node
        i = i + 1
    return 0

# Clone a generic attach-block method with T → concrete substituted,
# renaming it to `short_name` and clearing its type parameters. Keeps
# the original's is_static flag (+72) so codegen emits the right form.
fun clone_gen_method(orig: i64, types: i64, short_name: str) -> i64:
    tp: i64 = Memory.read_i64(orig + 40)
    pc: i32 = 0
    if tp != 0:
        pc = nl_count(tp)
    op: i64 = Memory.read_i64(orig + 16)
    np: i64 = mk_node_list(8)
    if op != 0:
        ppc: i32 = nl_count(op)
        ppi: i32 = 0
        while ppi < ppc:
            opn: i64 = nl_get(op, ppi)
            psub: str = Memory.read_i64(opn + 16) as str
            si: i32 = 0
            while si < pc:
                tp_it: i64 = nl_get(tp, si)
                tn: str = Memory.read_i64(tp_it + 0) as str
                if si < nl_count(types):
                    ct: str = nl_get(types, si) as str
                    psub = substitute_type(psub, tn, ct)
                si = si + 1
            nl_add(np, mk_param(Memory.read_i64(opn + 8) as str, psub, Memory.read_i64(opn + 24)))
            ppi = ppi + 1
    orig_ret: str = Memory.read_i64(orig + 24) as str
    nret: str = orig_ret
    si2: i32 = 0
    while si2 < pc:
        tp_it2: i64 = nl_get(tp, si2)
        tn2: str = Memory.read_i64(tp_it2 + 0) as str
        if si2 < nl_count(types):
            ct2: str = nl_get(types, si2) as str
            nret = substitute_type(nret, tn2, ct2)
        si2 = si2 + 1
    new_body: i64 = subst_body(Memory.read_i64(orig + 32), tp, types)
    new_m: i64 = mk_fun_def(short_name, np, nret, new_body, 0, Memory.read_i64(orig + 48), Memory.read_i64(orig + 56) as str, Memory.read_i64(orig + 64))
    Memory.write_i64(new_m + 72, Memory.read_i64(orig + 72))
    return new_m

# Ensure a generic INSTANCE-method instantiation exists. Clones the
# generic method into the struct's `attach` block as a concrete
# method `method__T` (so codegen emits it with proper struct/self
# context), registers it, and returns the short name `method__T`.
fun mono_ensure_method(ast: i64, struct_name: str, method: str, ta: i64) -> str:
    cnt: i32 = nl_count(ta)
    short: str = method
    i: i32 = 0
    while i < cnt:
        s: str = nl_get(ta, i) as str
        f: str = Str.replace(Str.replace(Str.replace(s, "[", "_"), "]", ""), ",", "_")
        if i == 0:
            short = Str.concat(Str.concat(short, "__"), f)
        else:
            short = Str.concat(Str.concat(short, "_"), f)
        i = i + 1
    canon_full: str = Str.concat(Str.concat(struct_name, "_"), short)
    if mono_done(canon_full) == 0:
        key: str = Str.concat(Str.concat(struct_name, "_"), method)
        o: i64 = find_gen_fn_node(key)
        if o != 0:
            clone: i64 = clone_gen_method(o, ta, short)
            blk: i64 = find_extend_block(ast, struct_name)
            if blk != 0:
                nl_add(Memory.read_i64(blk + 16), clone)
            pt: str = method_pt_str(Memory.read_i64(clone + 16))
            register_fun_sig_with_params(canon_full, Memory.read_i64(clone + 24) as str, pt)
            register_impl_method(struct_name, short, clone)
            mono_record(canon_full)
            mono_walk_list(ast, Memory.read_i64(clone + 32))
    return short

# ==========================================
# C1 Phase 1: Lambda Lifting
# Turns `|x| x + 1` into a top-level `fun __lambda_N(x) -> i32`
# plus a `NODE_FUN_REF("__lambda_N")` at the use site.
# Captures are NOT supported in Phase 1 — the lambda body can only
# reference its own params, struct/global names, and other top-level
# functions.
# ==========================================

g_lambda_counter: i32 = 0

# Build a unique top-level name for a lifted lambda.
fun next_lambda_name() -> str:
    n: str = Str.concat("__lambda_", Convert.i32_to_str(g_lambda_counter))
    g_lambda_counter = g_lambda_counter + 1
    return n

# ==========================================
# Phase 2: Capture analysis
# Walks a lambda body to find VAR_REF names that aren't:
#   (a) the lambda's own params
#   (b) registered globals
#   (c) registered top-level functions
# Those are "free variables" — captures from the enclosing scope.
# ==========================================

# Returns 1 if `name` is in the params list (skipping the lambda's own args).
fun is_lambda_param(name: str, params: i64) -> i32:
    if params == 0:
        return 0
    pc: i32 = nl_count(params)
    pi: i32 = 0
    while pi < pc:
        p: i64 = nl_get(params, pi)
        pn: str = Memory.read_i64(p + 8) as str
        if str_eq(pn, name) == 1:
            return 1
        pi = pi + 1
    return 0

# Names of vars declared inside the current lambda body (NODE_VAR_DECL).
# Set by lift_one_lambda before the capture walk and cleared after.
# Without this, a var declared inside the body (`n: i32 = 42`) gets
# misclassified as a free variable and the factory tries to capture it
# from the enclosing scope where it doesn't exist — codegen then fails
# with "Variable not declared: n" at the factory call site.
g_lift_locals: i64 = 0

fun is_lambda_local(name: str) -> i32:
    if g_lift_locals == 0:
        return 0
    c: i32 = nl_count(g_lift_locals)
    i: i32 = 0
    while i < c:
        if str_eq(nl_get(g_lift_locals, i) as str, name) == 1:
            return 1
        i = i + 1
    return 0

# A var name is "captured" if not a param of the lambda, not declared
# locally inside the lambda body, not a global, not a top-level fn name.
fun is_capture(name: str, params: i64, scope_capt: i64) -> i32:
    if is_lambda_param(name, params) == 1:
        return 0
    if is_lambda_local(name) == 1:
        return 0
    if is_global_var(name) == 1:
        return 0
    # Top-level fn?
    if str_eq(get_fun_ret_type(name), "unknown") == 0:
        return 0
    # Already collected?
    if scope_capt != 0:
        c: i32 = nl_count(scope_capt)
        i: i32 = 0
        while i < c:
            if str_eq(nl_get(scope_capt, i) as str, name) == 1:
                return 0
            i = i + 1
    return 1

# Walk a lambda body and collect every NODE_VAR_DECL's name into `out`.
# Recurses into the same containers collect_caps_node walks (blocks,
# if/while bodies) so a var declared inside an inner block is still
# treated as local to the lambda.
fun collect_locals_in_node(node: i64, out: i64):
    if node < 4096 as i64:
        return
    nt: i32 = nd_type(node)
    if nt <= 0 or nt > 200:
        return
    if nt == NODE_VAR_DECL:
        nm: str = Memory.read_i64(node + 16) as str
        nl_add(out, nm as i64)
        return
    if nt == NODE_BLOCK:
        collect_locals_in_list(Memory.read_i64(node + 8), out)
        return
    if nt == NODE_IF:
        collect_locals_in_list(Memory.read_i64(node + 16), out)
        collect_locals_in_list(Memory.read_i64(node + 24), out)
        return
    if nt == NODE_WHILE:
        collect_locals_in_list(Memory.read_i64(node + 16), out)
        return

fun collect_locals_in_list(lst: i64, out: i64):
    if lst == 0:
        return
    c: i32 = nl_count(lst)
    i: i32 = 0
    while i < c:
        collect_locals_in_node(nl_get(lst, i), out)
        i = i + 1

# Walk node and collect names of free variables into `out`.
fun collect_caps_node(node: i64, params: i64, out: i64):
    if node < 4096 as i64:
        return
    nt: i32 = nd_type(node)
    if nt <= 0 or nt > 200:
        return
    if nt == NODE_VAR_REF:
        name: str = Memory.read_i64(node + 8) as str
        if is_capture(name, params, out) == 1:
            nl_add(out, name as i64)
        return
    if nt == NODE_SELF or nt == NODE_SELF_FIELD:
        # `self` reference inside a lambda body. We capture it under the
        # synthetic name `__self` (the keyword `self` can't be a regular
        # local name, so a synthetic key avoids any clash). The lifter's
        # rewriter swaps NODE_SELF → var_ref(__self) and
        # NODE_SELF_FIELD(f) → field_access(__self, f) so the lifted
        # body has only ordinary var/field nodes — no implicit %self
        # needed at the top-level fn.
        if Memory.strlen(g_lift_method_struct) > 0:
            # Dedup: don't add __self twice if the body has multiple
            # self references.
            already: i32 = 0
            cc_self: i32 = nl_count(out)
            ic: i32 = 0
            while ic < cc_self:
                if str_eq(nl_get(out, ic) as str, "__self") == 1:
                    already = 1
                    ic = cc_self
                ic = ic + 1
            if already == 0:
                nl_add(out, "__self" as i64)
        return
    if nt == NODE_RETURN or nt == NODE_PAREN or nt == NODE_TRY_OP or nt == NODE_UNARY_OP:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        return
    if nt == NODE_VAR_DECL:
        collect_caps_node(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_ASSIGN or nt == NODE_FIELD_VAL:
        collect_caps_node(Memory.read_i64(node + 16), params, out)
        return
    if nt == NODE_FIELD_ASSIGN:
        collect_caps_node(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_NESTED_FIELD_ASSIGN:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        collect_caps_node(Memory.read_i64(node + 16), params, out)
        return
    if nt == NODE_BINARY_OP or nt == NODE_COMPARISON or nt == NODE_LOGICAL_OP or nt == NODE_STR_CONCAT:
        collect_caps_node(Memory.read_i64(node + 16), params, out)
        collect_caps_node(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_TERNARY:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        collect_caps_node(Memory.read_i64(node + 16), params, out)
        collect_caps_node(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_FUN_CALL or nt == NODE_BUILTIN_CALL:
        # The callee name itself can be a captured local — `f(g(x))` in
        # `compose` captures both `f` and `g`. is_capture filters out
        # top-level fns and globals, so it only fires for actual locals.
        cname: str = Memory.read_i64(node + 8) as str
        if is_capture(cname, params, out) == 1:
            nl_add(out, cname as i64)
        collect_caps_list(Memory.read_i64(node + 16), params, out)
        return
    if nt == NODE_STATIC_METHOD or nt == NODE_INST_METHOD:
        collect_caps_list(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_NESTED_METHOD:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        collect_caps_list(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_NESTED_FIELD:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        return
    if nt == NODE_CAST:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        return
    if nt == NODE_BLOCK:
        collect_caps_list(Memory.read_i64(node + 8), params, out)
        return
    if nt == NODE_IF:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        collect_caps_list(Memory.read_i64(node + 16), params, out)
        collect_caps_list(Memory.read_i64(node + 24), params, out)
        return
    if nt == NODE_WHILE:
        collect_caps_node(Memory.read_i64(node + 8), params, out)
        collect_caps_list(Memory.read_i64(node + 16), params, out)
        return

fun collect_caps_list(lst: i64, params: i64, out: i64):
    if lst == 0:
        return
    c: i32 = nl_count(lst)
    i: i32 = 0
    while i < c:
        collect_caps_node(nl_get(lst, i), params, out)
        i = i + 1

# Find the type of `name` by searching `scope_body` for a NODE_VAR_DECL
# or by checking if it's a fn-param of the enclosing fn (which we don't
# easily have — fall back to "i64" if the decl isn't found).
fun find_capture_type(scope_body: i64, scope_params: i64, name: str) -> str:
    # Synthetic `__self` capture: type comes from the enclosing
    # extend/impl block, tracked by g_lift_method_struct.
    if str_eq(name, "__self") == 1:
        if Memory.strlen(g_lift_method_struct) > 0:
            return g_lift_method_struct
        return "i64"
    # Check enclosing fn's params first
    if scope_params != 0:
        pc: i32 = nl_count(scope_params)
        pi: i32 = 0
        while pi < pc:
            p: i64 = nl_get(scope_params, pi)
            pn: str = Memory.read_i64(p + 8) as str
            if str_eq(pn, name) == 1:
                return Memory.read_i64(p + 16) as str
            pi = pi + 1
    # Check for a var_decl with this name in scope_body. Search
    # recursively so locals declared inside nested blocks (if / while /
    # block bodies) are found too — otherwise their type defaults to
    # i64 and a captured f32/f64 gets written/read at the wrong width,
    # silently corrupting the captured value.
    if scope_body != 0:
        found: str = find_vardecl_type_in_list(scope_body, name)
        if str_eq(found, "") == 0:
            return found
    return "i64"

# Recursively search a statement list for a var_decl named `name`,
# descending into if/while/block bodies. Returns the declared type, or
# "" if not found.
fun find_vardecl_type_in_list(lst: i64, name: str) -> str:
    if lst == 0:
        return ""
    bc: i32 = nl_count(lst)
    bi: i32 = 0
    while bi < bc:
        stmt: i64 = nl_get(lst, bi)
        if stmt != 0:
            r: str = find_vardecl_type_in_node(stmt, name)
            if str_eq(r, "") == 0:
                return r
        bi = bi + 1
    return ""

fun find_vardecl_type_in_node(stmt: i64, name: str) -> str:
    if stmt < 4096 as i64:
        return ""
    nt: i32 = nd_type(stmt)
    if nt == NODE_VAR_DECL:
        vname: str = Memory.read_i64(stmt + 16) as str
        if str_eq(vname, name) == 1:
            return Memory.read_i64(stmt + 8) as str
        return ""
    if nt == NODE_IF:
        r1: str = find_vardecl_type_in_list(Memory.read_i64(stmt + 16), name)
        if str_eq(r1, "") == 0:
            return r1
        return find_vardecl_type_in_list(Memory.read_i64(stmt + 24), name)
    if nt == NODE_WHILE:
        return find_vardecl_type_in_list(Memory.read_i64(stmt + 16), name)
    if nt == NODE_BLOCK:
        return find_vardecl_type_in_list(Memory.read_i64(stmt + 8), name)
    return ""

# Pick the right Memory.read_X method for a capture's type.
fun mem_read_for_type(t: str) -> str:
    if str_eq(t, "i32") == 1:
        return "read_i32"
    if str_eq(t, "i64") == 1:
        return "read_i64"
    if str_eq(t, "bool") == 1:
        return "read_i32"
    if str_eq(t, "f64") == 1:
        return "read_f64"
    if str_eq(t, "f32") == 1:
        return "read_f32"
    return "read_i64"

# Pick the right Memory.write_X method for a capture's type.
fun mem_write_for_type(t: str) -> str:
    if str_eq(t, "i32") == 1:
        return "write_i32"
    if str_eq(t, "i64") == 1:
        return "write_i64"
    if str_eq(t, "bool") == 1:
        return "write_i32"
    if str_eq(t, "f64") == 1:
        return "write_f64"
    if str_eq(t, "f32") == 1:
        return "write_f32"
    return "write_i64"

# ==========================================
# Capture rewriting (mutable captures persist across calls)
# ==========================================
# Old approach: prepend `n: T = Memory.read_T(env+offset)` to the lifted
# body, treating captures as locals. Mutations updated the local but
# never wrote back to env, so each call started over from env's stale
# value (counter pattern: 1, 1, 1 instead of 1, 2, 3).
#
# New approach: rewrite the body so every reference to a captured name
# becomes a direct env load/store. The env IS the variable's home. No
# locals, no write-back, mutations persist naturally.

# Returns the index of `name` in the captures list, or -1 if absent.
fun capture_index(name: str, captures: i64) -> i32:
    if captures == 0:
        return -1
    cc: i32 = nl_count(captures)
    ci: i32 = 0
    while ci < cc:
        cn: str = nl_get(captures, ci) as str
        if str_eq(cn, name) == 1:
            return ci
        ci = ci + 1
    return -1

# A capture is "rewriteable" if rewriting var_ref(n) → Memory.read_T(env+off)
# preserves all the type information codegen needs at use sites.
#
# Allow-list of scalar primitives + str. Everything else (closures,
# structs, enums, generics) keeps the var-decl prologue so the call
# site / field-access / method-dispatch codegen can see the proper
# typed slot. A raw `Memory.read_i64(env+8)` discards type info and
# codegen falls back to "i64 doesn't have a `(...)` operator" or
# `getelementptr ...[0, -1]` on an unknown struct.
fun is_rewriteable_ctype(ct: str) -> i32:
    if str_eq(ct, "i8") == 1:
        return 1
    if str_eq(ct, "i16") == 1:
        return 1
    if str_eq(ct, "i32") == 1:
        return 1
    if str_eq(ct, "i64") == 1:
        return 1
    if str_eq(ct, "u8") == 1:
        return 1
    if str_eq(ct, "u16") == 1:
        return 1
    if str_eq(ct, "u32") == 1:
        return 1
    if str_eq(ct, "u64") == 1:
        return 1
    if str_eq(ct, "f32") == 1:
        return 1
    if str_eq(ct, "f64") == 1:
        return 1
    if str_eq(ct, "bool") == 1:
        return 1
    if str_eq(ct, "char") == 1:
        return 1
    if str_eq(ct, "str") == 1:
        return 1
    return 0

# Build an expression that reads capture #idx from __env. Layout:
# env[0..8) = fn_ptr, env[8+idx*8 ..) = capture i.
fun build_env_load(idx: i32, ctype: str) -> i64:
    offset_lit: i64 = mk_int_lit(8 + (idx as i64) * 8)
    env_as_i64: i64 = mk_cast(mk_var_ref("__env"), "i64")
    addr_expr: i64 = mk_binary_op("+", env_as_i64, offset_lit)
    rargs: i64 = mk_node_list(2)
    nl_add(rargs, addr_expr)
    rcall: i64 = mk_static_method("Memory", mem_read_for_type(ctype), rargs)
    if str_eq(ctype, "str") == 1:
        return mk_cast(rcall, "str")
    return rcall

# Build a statement that writes `value_expr` into capture #idx of __env.
fun build_env_store(idx: i32, ctype: str, value_expr: i64) -> i64:
    offset_lit2: i64 = mk_int_lit(8 + (idx as i64) * 8)
    env_as_i64_2: i64 = mk_cast(mk_var_ref("__env"), "i64")
    addr_expr2: i64 = mk_binary_op("+", env_as_i64_2, offset_lit2)
    val: i64 = value_expr
    if str_eq(ctype, "str") == 1:
        val = mk_cast(value_expr, "i64")
    wargs: i64 = mk_node_list(2)
    nl_add(wargs, addr_expr2)
    nl_add(wargs, val)
    return mk_static_method("Memory", mem_write_for_type(ctype), wargs)

# Walk a node, replacing var_refs and assigns to captured names with
# direct env loads/stores. Returns the (possibly new) node — caller
# must update the parent's slot if the returned pointer differs.
fun rewrite_captures_in(node: i64, captures: i64, cap_types: i64) -> i64:
    if node < 4096 as i64:
        return node
    nt: i32 = nd_type(node)
    if nt <= 0 or nt > 200:
        return node

    if nt == NODE_VAR_REF:
        name: str = var_ref_name(node)
        idx: i32 = capture_index(name, captures)
        if idx >= 0:
            ct: str = nl_get(cap_types, idx) as str
            if is_rewriteable_ctype(ct) == 1:
                return build_env_load(idx, ct)
        return node

    # `self` references → ordinary var_ref to the captured `__self`
    # local. The lifted body is a top-level fn (no implicit %self), so
    # leaving NODE_SELF as-is would emit `%self` against an undeclared
    # value. The local has been registered via the var-decl prologue
    # (struct types are non-rewriteable, so prologue applies).
    if nt == NODE_SELF:
        idx_self: i32 = capture_index("__self", captures)
        if idx_self >= 0:
            return mk_var_ref("__self")
        return node

    # `self.field` → ordinary field_access on the captured `__self`.
    if nt == NODE_SELF_FIELD:
        idx_sf: i32 = capture_index("__self", captures)
        if idx_sf >= 0:
            field_name: str = Memory.read_i64(node + 8) as str
            return mk_field_access("__self", field_name)
        return node

    if nt == NODE_ASSIGN:
        aname: str = assign_name(node)
        v: i64 = assign_value(node)
        nv: i64 = rewrite_captures_in(v, captures, cap_types)
        aidx: i32 = capture_index(aname, captures)
        if aidx >= 0:
            ct2: str = nl_get(cap_types, aidx) as str
            if is_rewriteable_ctype(ct2) == 1:
                return build_env_store(aidx, ct2, nv)
        if nv != v:
            Memory.write_i64(node + 16, nv)
        return node

    if nt == NODE_VAR_DECL:
        v2: i64 = Memory.read_i64(node + 24)
        nv2: i64 = rewrite_captures_in(v2, captures, cap_types)
        if nv2 != v2:
            Memory.write_i64(node + 24, nv2)
        return node

    if nt == NODE_RETURN:
        v3: i64 = Memory.read_i64(node + 8)
        nv3: i64 = rewrite_captures_in(v3, captures, cap_types)
        if nv3 != v3:
            Memory.write_i64(node + 8, nv3)
        return node

    if nt == NODE_BINARY_OP or nt == NODE_COMPARISON or nt == NODE_LOGICAL_OP:
        l: i64 = Memory.read_i64(node + 16)
        r: i64 = Memory.read_i64(node + 24)
        nl: i64 = rewrite_captures_in(l, captures, cap_types)
        nr: i64 = rewrite_captures_in(r, captures, cap_types)
        if nl != l:
            Memory.write_i64(node + 16, nl)
        if nr != r:
            Memory.write_i64(node + 24, nr)
        return node

    if nt == NODE_FUN_CALL or nt == NODE_BUILTIN_CALL:
        rewrite_captures_in_list(Memory.read_i64(node + 16), captures, cap_types)
        return node
    if nt == NODE_STATIC_METHOD or nt == NODE_INST_METHOD:
        rewrite_captures_in_list(Memory.read_i64(node + 24), captures, cap_types)
        return node
    if nt == NODE_NESTED_METHOD:
        in2: i64 = Memory.read_i64(node + 8)
        nin: i64 = rewrite_captures_in(in2, captures, cap_types)
        if nin != in2:
            Memory.write_i64(node + 8, nin)
        rewrite_captures_in_list(Memory.read_i64(node + 24), captures, cap_types)
        return node

    if nt == NODE_FIELD_VAL:
        v4: i64 = Memory.read_i64(node + 16)
        nv4: i64 = rewrite_captures_in(v4, captures, cap_types)
        if nv4 != v4:
            Memory.write_i64(node + 16, nv4)
        return node

    if nt == NODE_FIELD_ASSIGN:
        v5: i64 = Memory.read_i64(node + 24)
        nv5: i64 = rewrite_captures_in(v5, captures, cap_types)
        if nv5 != v5:
            Memory.write_i64(node + 24, nv5)
        return node

    if nt == NODE_NESTED_FIELD_ASSIGN:
        nfa_t: i64 = Memory.read_i64(node + 8)
        nfa_nt: i64 = rewrite_captures_in(nfa_t, captures, cap_types)
        if nfa_nt != nfa_t:
            Memory.write_i64(node + 8, nfa_nt)
        nfa_v: i64 = Memory.read_i64(node + 16)
        nfa_nv: i64 = rewrite_captures_in(nfa_v, captures, cap_types)
        if nfa_nv != nfa_v:
            Memory.write_i64(node + 16, nfa_nv)
        return node

    if nt == NODE_BLOCK:
        rewrite_captures_in_list(Memory.read_i64(node + 8), captures, cap_types)
        return node
    if nt == NODE_IF:
        cnd: i64 = Memory.read_i64(node + 8)
        ncnd: i64 = rewrite_captures_in(cnd, captures, cap_types)
        if ncnd != cnd:
            Memory.write_i64(node + 8, ncnd)
        rewrite_captures_in_list(Memory.read_i64(node + 16), captures, cap_types)
        rewrite_captures_in_list(Memory.read_i64(node + 24), captures, cap_types)
        return node
    if nt == NODE_WHILE:
        wc: i64 = Memory.read_i64(node + 8)
        nwc: i64 = rewrite_captures_in(wc, captures, cap_types)
        if nwc != wc:
            Memory.write_i64(node + 8, nwc)
        rewrite_captures_in_list(Memory.read_i64(node + 16), captures, cap_types)
        return node

    return node

fun rewrite_captures_in_list(lst: i64, captures: i64, cap_types: i64):
    if lst == 0:
        return
    c: i32 = nl_count(lst)
    cap: i32 = Memory.read_i32(lst + 4)
    if c > cap:
        c = cap
    i: i32 = 0
    while i < c:
        item: i64 = nl_get(lst, i)
        new_item: i64 = rewrite_captures_in(item, captures, cap_types)
        if new_item != item:
            nl_set(lst, i, new_item)
        i = i + 1

# Scope tracking — enclosing fn's body+params, used by capture analysis
# to look up types of captured local vars.
g_lift_scope_body: i64 = 0
g_lift_scope_params: i64 = 0
# Enclosing fn's return type (used for `return |...|` escape check).
g_lift_scope_ret_type: str = ""
# Phase 3: parent-context tracking. Set by the walker before recursing
# into a child. Used by lift_one_lambda to decide stack vs heap env.
g_lift_parent_type: i32 = 0
# Phase 3+: type of the var-decl whose value is the lambda being lifted.
# Used to detect `@heap fun(...)` annotation.
g_lift_target_type: str = ""
# Phase 4+: name of the struct whose method we're inside, set when the
# walker enters NODE_EXTEND_BLOCK / NODE_IMPL_BLOCK and restored on
# exit. Used to resolve `self` captures to the right struct type and
# to refuse self-capture outside any method (g_lift_method_struct
# stays "" at top level).
g_lift_method_struct: str = ""

# Lift one lambda node into a top-level fun_def. If the body has free
# variables (captures from enclosing scope), generate an env-allocating
# factory and rewrite to call it. Returns the replacement expression.
fun lift_one_lambda(ast: i64, node: i64) -> i64:
    params: i64 = Memory.read_i64(node + 8)
    body: i64 = Memory.read_i64(node + 16)
    ret_type: str = Memory.read_i64(node + 24) as str
    if (ret_type as i64) == 0:
        ret_type = ""

    # Phase 2: capture analysis — collect free variable names.
    # Pre-collect names of vars DECLARED inside this body so the walker
    # can exclude them. Without this, `n: i32 = 42` inside the body
    # makes `n` look free and the factory tries to capture it from the
    # enclosing scope where it doesn't exist.
    old_locals: i64 = g_lift_locals
    g_lift_locals = mk_node_list(8)
    collect_locals_in_list(body, g_lift_locals)

    captures: i64 = mk_node_list(8)
    collect_caps_list(body, params, captures)
    cap_count: i32 = nl_count(captures)

    # Restore prior locals scope (handles nested lambdas correctly).
    g_lift_locals = old_locals

    # NOTE: even non-capturing lambdas go through env convention so the
    # gen_indirect_call site has uniform handling. Tiny env = {fn_ptr}.

    # Allocation rule (one consistent pattern: stack default, `@heap`
    # explicit). Same as Dolet's `@heap struct` annotation — the user
    # is always explicit when they want heap.
    #   - var-decl:  stack by default; `@heap fun(...)` opts in to heap.
    #   - return:    require `@heap` on the return type. Stack return
    #                is provably UAF, so we refuse to compile and tell
    #                the user how to fix it.
    #   - elsewhere: stack (passed-as-arg, etc.)
    use_stack: i32 = 1
    if g_lift_parent_type == NODE_VAR_DECL:
        if Str.starts_with(g_lift_target_type, "@heap ") == 1:
            use_stack = 0
    elif g_lift_parent_type == NODE_RETURN:
        if Str.starts_with(g_lift_scope_ret_type, "@heap ") == 1:
            use_stack = 0
        else:
            msg: str = "closure escapes via return; mark return type with `@heap` (e.g. `fun foo() -> @heap fun(i32) -> i32`)"
            panic(msg)

    # Phase 2 path — captures present. Build:
    #   1) cap_types[]    — types of each captured name (from enclosing scope)
    #   2) lifted fn      — takes env: ptr first, body prepended with
    #                       `<name>: <type> = Memory.read_X(env + offset)`
    #   3) factory fn     — takes captures as params, mallocs env,
    #                       writes fn_ptr + captures, returns env ptr
    #   4) replacement    — NODE_FUN_CALL to factory passing captured values

    # Allocate parallel arrays for type / offset
    cap_types: i64 = mk_node_list(8)
    ci: i32 = 0
    while ci < cap_count:
        cn: str = nl_get(captures, ci) as str
        ct: str = find_capture_type(g_lift_scope_body, g_lift_scope_params, cn)
        nl_add(cap_types, ct as i64)
        ci = ci + 1

    name: str = next_lambda_name()
    factory_name: str = Str.concat(name, "_make")

    # ------ Build lifted fn ------
    new_params: i64 = mk_node_list(8)
    nl_add(new_params, mk_param("__env", "ptr", 0))
    pp: i32 = 0
    if params != 0:
        ppc: i32 = nl_count(params)
        while pp < ppc:
            nl_add(new_params, nl_get(params, pp))
            pp = pp + 1

    # Hybrid capture handling:
    #   - Rewriteable types (i32/i64/f*/bool/str): rewrite var_ref(n) →
    #     Memory.read_T(env+off) and assign(n=v) → Memory.write_T. The
    #     env IS the variable's home, so mutations persist across calls.
    #   - Non-rewriteable types (closures `fun(...)`, structs): prepend
    #     a var-decl `n: T = Memory.read_T(env+off)` so the call site
    #     keeps full type info (closure-call needs to know arg/ret
    #     types, struct field access needs the layout). These captures
    #     are effectively read-only inside the lambda — mutating a
    #     captured closure isn't a meaningful operation anyway.
    new_body: i64 = mk_node_list(16)
    cj: i32 = 0
    while cj < cap_count:
        cn2: str = nl_get(captures, cj) as str
        ct2: str = nl_get(cap_types, cj) as str
        if is_rewriteable_ctype(ct2) == 0:
            offset_lit: i64 = mk_int_lit(8 + (cj as i64) * 8)
            env_as_i64: i64 = mk_cast(mk_var_ref("__env"), "i64")
            addr_expr: i64 = mk_binary_op("+", env_as_i64, offset_lit)
            rargs: i64 = mk_node_list(2)
            nl_add(rargs, addr_expr)
            rcall: i64 = mk_static_method("Memory", mem_read_for_type(ct2), rargs)
            # For struct-typed captures (e.g. `__self: Counter`), the
            # read returns i64 but the var-decl needs a Counter pointer
            # for downstream getelementptr — without an explicit cast
            # the i64 leaks into ptr-typed contexts and MLIR rejects.
            # Closure-typed captures (fun(...)) are pre-existing — the
            # codegen already handles their i64 → ptr coercion at the
            # call site, so leave those alone.
            init_val: i64 = rcall
            if Str.starts_with(ct2, "fun(") == false:
                if Str.starts_with(ct2, "@heap fun(") == false:
                    init_val = mk_cast(rcall, ct2)
            nl_add(new_body, mk_var_decl(ct2, cn2, init_val, 0, 0, 0))
        cj = cj + 1
    if body != 0:
        rewrite_captures_in_list(body, captures, cap_types)
        bc: i32 = nl_count(body)
        bi2: i32 = 0
        while bi2 < bc:
            nl_add(new_body, nl_get(body, bi2))
            bi2 = bi2 + 1

    fn_def: i64 = mk_fun_def(name, new_params, ret_type, new_body, 0, 0, "", 0)
    nl_add(ast, fn_def)
    fn_pt: str = build_param_types_str(new_params)
    fn_mang: str = register_overload(name, fn_pt)
    register_fun_sig_with_params(fn_mang, ret_type, fn_pt)

    if use_stack == 1:
        # Phase 3: stack-allocate via struct. Each capture stored as
        # i64 to match the lifted fn's Memory.read_X(env + 8*n) layout.
        env_struct_name: str = Str.concat(name, "_env")
        env_fields: i64 = mk_node_list(8)
        nl_add(env_fields, mk_struct_field("__fn", "ptr", 0, 0, "public", 0))
        cs: i32 = 0
        while cs < cap_count:
            cn_s: str = nl_get(captures, cs) as str
            nl_add(env_fields, mk_struct_field(cn_s, "i64", 0, 0, "public", 0))
            cs = cs + 1
        env_struct_decl: i64 = mk_struct_decl(env_struct_name, env_fields, 0, "", 0, 0, 0, 0)
        nl_add(ast, env_struct_decl)
        register_struct(env_struct_name, env_fields)

        # Build field-val args: __fn=__lambda_N_ref, cap1=cap1_value (cast to i64), ...
        sval_args: i64 = mk_node_list(8)
        nl_add(sval_args, mk_field_val("__fn", mk_fun_ref(name)))
        cs2: i32 = 0
        while cs2 < cap_count:
            cn_s2: str = nl_get(captures, cs2) as str
            ct_s2: str = nl_get(cap_types, cs2) as str
            # __self is the synthetic name our lifter uses for self
            # captures; the actual value at the call site is the
            # enclosing method's implicit self, parsed as NODE_SELF.
            v_expr: i64 = 0
            if str_eq(cn_s2, "__self") == 1:
                v_expr = mk_self()
            else:
                v_expr = mk_var_ref(cn_s2)
            if str_eq(ct_s2, "i64") == 0:
                v_expr = mk_cast(v_expr, "i64")
            nl_add(sval_args, mk_field_val(cn_s2, v_expr))
            cs2 = cs2 + 1
        # Returning struct instantiation — gen_struct_instantiation emits
        # alloca + field stores in the caller's stack frame.
        return mk_fun_call(env_struct_name, sval_args, 0)

    # ------ Heap path: build factory fn that mallocs env ------
    fact_params: i64 = mk_node_list(8)
    ck: i32 = 0
    while ck < cap_count:
        cn3: str = nl_get(captures, ck) as str
        ct3: str = nl_get(cap_types, ck) as str
        nl_add(fact_params, mk_param(cn3, ct3, 0))
        ck = ck + 1
    fact_body: i64 = mk_node_list(16)
    sz_bytes: i64 = 8 + (cap_count as i64) * 8
    malloc_args: i64 = mk_node_list(2)
    nl_add(malloc_args, mk_int_lit(sz_bytes))
    malloc_call: i64 = mk_static_method("Memory", "malloc", malloc_args)
    addr_decl: i64 = mk_var_decl("i64", "__addr", mk_cast(malloc_call, "i64"), 0, 0, 0)
    nl_add(fact_body, addr_decl)
    fnref_args: i64 = mk_node_list(2)
    nl_add(fnref_args, mk_var_ref("__addr"))
    nl_add(fnref_args, mk_cast(mk_fun_ref(name), "i64"))
    nl_add(fact_body, mk_static_method("Memory", "write_i64", fnref_args))
    cm: i32 = 0
    while cm < cap_count:
        cn4: str = nl_get(captures, cm) as str
        ct4: str = nl_get(cap_types, cm) as str
        write_off: i64 = mk_int_lit(8 + (cm as i64) * 8)
        write_addr: i64 = mk_binary_op("+", mk_var_ref("__addr"), write_off)
        write_args: i64 = mk_node_list(2)
        nl_add(write_args, write_addr)
        write_val: i64 = mk_var_ref(cn4)
        if str_eq(ct4, "str") == 1:
            write_val = mk_cast(mk_var_ref(cn4), "i64")
        nl_add(write_args, write_val)
        nl_add(fact_body, mk_static_method("Memory", mem_write_for_type(ct4), write_args))
        cm = cm + 1
    nl_add(fact_body, mk_return(mk_cast(mk_var_ref("__addr"), "ptr")))

    fact_def: i64 = mk_fun_def(factory_name, fact_params, "ptr", fact_body, 0, 0, "", 0)
    nl_add(ast, fact_def)
    fact_pt: str = build_param_types_str(fact_params)
    fact_mang: str = register_overload(factory_name, fact_pt)
    register_fun_sig_with_params(fact_mang, "ptr", fact_pt)

    # ------ Build replacement: factory_name(captured_var_refs...) ------
    call_args: i64 = mk_node_list(8)
    co: i32 = 0
    while co < cap_count:
        cn5: str = nl_get(captures, co) as str
        # __self captured → pass the enclosing method's implicit self.
        if str_eq(cn5, "__self") == 1:
            nl_add(call_args, mk_self())
        else:
            nl_add(call_args, mk_var_ref(cn5))
        co = co + 1
    return mk_fun_call(factory_name, call_args, 0)

# Recursively walk a node, lifting any nested lambdas. Returns the
# (possibly replaced) node so callers can write the new pointer back
# into the parent's child slot.
fun lift_lambdas_in(ast: i64, node: i64) -> i64:
    # Defensive guard: nodes are heap-malloc'd, so a valid pointer is
    # always > 4KB. Catches walker bugs where a slot holds a small int
    # (flag, index) or a string pointer that happens to read as a
    # nonsense node-type. Any nt outside the known AST range bails out.
    if node < 4096 as i64:
        return node
    nt: i32 = nd_type(node)
    if nt <= 0 or nt > 200:
        return node
    if nt == NODE_LAMBDA:
        return lift_one_lambda(ast, node)

    if nt == NODE_VAR_DECL:
        # Phase 3+: tell child it's a var-decl value, plus the var's type
        # (to detect `@heap` annotation).
        old_pt: i32 = g_lift_parent_type
        old_tt: str = g_lift_target_type
        g_lift_parent_type = NODE_VAR_DECL
        g_lift_target_type = Memory.read_i64(node + 8) as str
        v: i64 = Memory.read_i64(node + 24)
        nv: i64 = lift_lambdas_in(ast, v)
        g_lift_parent_type = old_pt
        g_lift_target_type = old_tt
        if nv != v:
            Memory.write_i64(node + 24, nv)
        return node
    if nt == NODE_RETURN:
        # Phase 3+: lambda inside a return — needs `@heap` on enclosing
        # fn's return type, else compile error.
        old_pt2: i32 = g_lift_parent_type
        g_lift_parent_type = NODE_RETURN
        v2: i64 = Memory.read_i64(node + 8)
        nv2: i64 = lift_lambdas_in(ast, v2)
        g_lift_parent_type = old_pt2
        if nv2 != v2:
            Memory.write_i64(node + 8, nv2)
        return node
    if nt == NODE_ASSIGN:
        v3: i64 = Memory.read_i64(node + 16)
        nv3: i64 = lift_lambdas_in(ast, v3)
        if nv3 != v3:
            Memory.write_i64(node + 16, nv3)
        return node
    if nt == NODE_FIELD_ASSIGN:
        v3b: i64 = Memory.read_i64(node + 24)
        nv3b: i64 = lift_lambdas_in(ast, v3b)
        if nv3b != v3b:
            Memory.write_i64(node + 24, nv3b)
        return node
    if nt == NODE_NESTED_FIELD_ASSIGN:
        nfa_t2: i64 = Memory.read_i64(node + 8)
        nfa_nt2: i64 = lift_lambdas_in(ast, nfa_t2)
        if nfa_nt2 != nfa_t2:
            Memory.write_i64(node + 8, nfa_nt2)
        nfa_v2: i64 = Memory.read_i64(node + 16)
        nfa_nv2: i64 = lift_lambdas_in(ast, nfa_v2)
        if nfa_nv2 != nfa_v2:
            Memory.write_i64(node + 16, nfa_nv2)
        return node
    if nt == NODE_FIELD_VAL:
        v4: i64 = Memory.read_i64(node + 16)
        nv4: i64 = lift_lambdas_in(ast, v4)
        if nv4 != v4:
            Memory.write_i64(node + 16, nv4)
        return node
    if nt == NODE_BINARY_OP or nt == NODE_COMPARISON or nt == NODE_LOGICAL_OP:
        l: i64 = Memory.read_i64(node + 16)
        r: i64 = Memory.read_i64(node + 24)
        nl: i64 = lift_lambdas_in(ast, l)
        nr: i64 = lift_lambdas_in(ast, r)
        if nl != l:
            Memory.write_i64(node + 16, nl)
        if nr != r:
            Memory.write_i64(node + 24, nr)
        return node

    # For arg lists on function/method calls — walk each entry and
    # write the replacement back into the list's data area.
    if nt == NODE_FUN_CALL or nt == NODE_BUILTIN_CALL:
        lift_lambdas_in_list(ast, Memory.read_i64(node + 16))
        return node
    if nt == NODE_STATIC_METHOD or nt == NODE_INST_METHOD:
        lift_lambdas_in_list(ast, Memory.read_i64(node + 24))
        return node
    if nt == NODE_NESTED_METHOD:
        in2: i64 = Memory.read_i64(node + 8)
        nin: i64 = lift_lambdas_in(ast, in2)
        if nin != in2:
            Memory.write_i64(node + 8, nin)
        lift_lambdas_in_list(ast, Memory.read_i64(node + 24))
        return node

    if nt == NODE_FUN_DEF:
        # Lift any lambdas nested in the body, but DON'T cross into
        # generic-fn bodies (their T refs need substitution first).
        if Memory.read_i64(node + 40) == 0:
            # Push scope (enclosing fn body+params+ret_type) for the
            # capture analysis and `@heap` escape check.
            old_body: i64 = g_lift_scope_body
            old_params: i64 = g_lift_scope_params
            old_ret: str = g_lift_scope_ret_type
            g_lift_scope_body = Memory.read_i64(node + 32)
            g_lift_scope_params = Memory.read_i64(node + 16)
            g_lift_scope_ret_type = Memory.read_i64(node + 24) as str
            lift_lambdas_in_list(ast, Memory.read_i64(node + 32))
            g_lift_scope_body = old_body
            g_lift_scope_params = old_params
            g_lift_scope_ret_type = old_ret
        return node

    # Methods live inside extend/impl blocks as NODE_FUN_DEFs in the
    # block's methods list. Without this case the lifter only sees
    # top-level fns, so a lambda inside a method body never gets
    # lifted — the method silently compiles to `return null` and the
    # caller segfaults dereferencing the null closure.
    #
    # Set g_lift_method_struct so any lambda nested inside the method
    # bodies knows which struct's `self` it can capture.
    if nt == NODE_EXTEND_BLOCK:
        old_ms: str = g_lift_method_struct
        g_lift_method_struct = Memory.read_i64(node + 8) as str
        lift_lambdas_in_list(ast, Memory.read_i64(node + 16))
        g_lift_method_struct = old_ms
        return node
    if nt == NODE_IMPL_BLOCK:
        old_ms2: str = g_lift_method_struct
        g_lift_method_struct = Memory.read_i64(node + 8) as str
        lift_lambdas_in_list(ast, Memory.read_i64(node + 16))
        g_lift_method_struct = old_ms2
        return node

    if nt == NODE_BLOCK:
        lift_lambdas_in_list(ast, Memory.read_i64(node + 8))
        return node
    if nt == NODE_IF:
        cnd: i64 = Memory.read_i64(node + 8)
        ncnd: i64 = lift_lambdas_in(ast, cnd)
        if ncnd != cnd:
            Memory.write_i64(node + 8, ncnd)
        lift_lambdas_in_list(ast, Memory.read_i64(node + 16))
        lift_lambdas_in_list(ast, Memory.read_i64(node + 24))
        return node
    if nt == NODE_WHILE:
        wc: i64 = Memory.read_i64(node + 8)
        nwc: i64 = lift_lambdas_in(ast, wc)
        if nwc != wc:
            Memory.write_i64(node + 8, nwc)
        lift_lambdas_in_list(ast, Memory.read_i64(node + 16))
        return node

    return node

fun lift_lambdas_in_list(ast: i64, lst: i64):
    if lst == 0:
        return
    c: i32 = nl_count(lst)
    cap: i32 = Memory.read_i32(lst + 4)
    if c > cap:
        c = cap
    i: i32 = 0
    while i < c:
        old: i64 = nl_get(lst, i)
        if old != 0:
            new: i64 = lift_lambdas_in(ast, old)
            if new != old:
                nl_set(lst, i, new)
        i = i + 1

# Quick scan: does the AST contain ANY NODE_LAMBDA anywhere?
# If not, we skip the (possibly-buggy) walker entirely.
g_has_lambda: i32 = 0

fun scan_for_lambda_node(node: i64):
    if node < 4096 as i64:
        return
    if g_has_lambda == 1:
        return
    nt: i32 = nd_type(node)
    if nt <= 0 or nt > 200:
        return
    if nt == NODE_LAMBDA:
        g_has_lambda = 1
        return
    # Recurse into common containers
    if nt == NODE_VAR_DECL:
        scan_for_lambda_node(Memory.read_i64(node + 24))
        return
    if nt == NODE_RETURN:
        scan_for_lambda_node(Memory.read_i64(node + 8))
        return
    if nt == NODE_ASSIGN:
        scan_for_lambda_node(Memory.read_i64(node + 16))
        return
    if nt == NODE_FIELD_ASSIGN:
        scan_for_lambda_node(Memory.read_i64(node + 24))
        return
    if nt == NODE_NESTED_FIELD_ASSIGN:
        scan_for_lambda_node(Memory.read_i64(node + 8))
        scan_for_lambda_node(Memory.read_i64(node + 16))
        return
    if nt == NODE_BINARY_OP or nt == NODE_COMPARISON or nt == NODE_LOGICAL_OP:
        scan_for_lambda_node(Memory.read_i64(node + 16))
        scan_for_lambda_node(Memory.read_i64(node + 24))
        return
    if nt == NODE_FUN_CALL or nt == NODE_BUILTIN_CALL:
        scan_for_lambda_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_STATIC_METHOD or nt == NODE_INST_METHOD:
        scan_for_lambda_list(Memory.read_i64(node + 24))
        return
    if nt == NODE_FUN_DEF:
        if Memory.read_i64(node + 40) == 0:
            scan_for_lambda_list(Memory.read_i64(node + 32))
        return
    # Control-flow blocks — a lambda nested inside an if/while/block body
    # must still be discovered, otherwise the whole lift pass is skipped
    # and the lambda compiles to a null closure (segfault on call).
    if nt == NODE_IF:
        scan_for_lambda_node(Memory.read_i64(node + 8))
        scan_for_lambda_list(Memory.read_i64(node + 16))
        scan_for_lambda_list(Memory.read_i64(node + 24))
        return
    if nt == NODE_WHILE:
        scan_for_lambda_node(Memory.read_i64(node + 8))
        scan_for_lambda_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_BLOCK:
        scan_for_lambda_list(Memory.read_i64(node + 8))
        return
    # Methods inside extend/impl blocks — same NODE_FUN_DEF body, just
    # nested one level deeper. Without these, a lambda inside a method
    # is invisible to the scan and the whole lift pass gets skipped.
    if nt == NODE_EXTEND_BLOCK:
        scan_for_lambda_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_IMPL_BLOCK:
        scan_for_lambda_list(Memory.read_i64(node + 16))
        return

fun scan_for_lambda_list(lst: i64):
    if lst == 0:
        return
    if g_has_lambda == 1:
        return
    c: i32 = nl_count(lst)
    i: i32 = 0
    while i < c and g_has_lambda == 0:
        scan_for_lambda_node(nl_get(lst, i))
        i = i + 1

fun lambda_lift_pass(ast: i64):
    g_lambda_counter = 0
    g_has_lambda = 0
    scan_for_lambda_list(ast)
    if g_has_lambda == 0:
        return
    lift_lambdas_in_list(ast, ast)

fun monomorphize_pass(ast: i64):
    init_mono_registry()
    lambda_lift_pass(ast)
    mono_walk_list(ast, ast)
