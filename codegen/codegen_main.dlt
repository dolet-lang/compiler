##############################
# MLIR Codegen Main
# generate(), statement dispatch, runtime, main function
# Depends on: all other codegen files
##############################

# gen_statement and gen_var_decl moved to codegen_stmt.dlt (forward-ref fix)

# ==========================================
# Generate Pure Runtime Declarations
# ==========================================
fun gen_runtime_decls():
    # String comparison (inline implementation — no libc needed)
    emit_ind("// Inline strcmp implementation")
    emit_ind("llvm.func @strcmp(%a: !llvm.ptr, %b: !llvm.ptr) -> i32 {")
    emit_ind("  %zero = llvm.mlir.constant(0 : i32) : i32")
    emit_ind("  %one = llvm.mlir.constant(1 : i64) : i64")
    emit_ind("  %z8 = llvm.mlir.constant(0 : i8) : i8")
    emit_ind("  llvm.br ^loop(%a, %b : !llvm.ptr, !llvm.ptr)")
    emit_ind("^loop(%p1: !llvm.ptr, %p2: !llvm.ptr):")
    emit_ind("  %c1 = llvm.load %p1 : !llvm.ptr -> i8")
    emit_ind("  %c2 = llvm.load %p2 : !llvm.ptr -> i8")
    emit_ind("  %ne = llvm.icmp \"ne\" %c1, %c2 : i8")
    emit_ind("  llvm.cond_br %ne, ^diff(%c1, %c2 : i8, i8), ^same(%c1, %p1, %p2 : i8, !llvm.ptr, !llvm.ptr)")
    emit_ind("^same(%sc: i8, %sp1: !llvm.ptr, %sp2: !llvm.ptr):")
    emit_ind("  %isz = llvm.icmp \"eq\" %sc, %z8 : i8")
    emit_ind("  llvm.cond_br %isz, ^ret(%zero : i32), ^next(%sp1, %sp2 : !llvm.ptr, !llvm.ptr)")
    emit_ind("^next(%np1: !llvm.ptr, %np2: !llvm.ptr):")
    emit_ind("  %np1n = llvm.getelementptr %np1[%one] : (!llvm.ptr, i64) -> !llvm.ptr, i8")
    emit_ind("  %np2n = llvm.getelementptr %np2[%one] : (!llvm.ptr, i64) -> !llvm.ptr, i8")
    emit_ind("  llvm.br ^loop(%np1n, %np2n : !llvm.ptr, !llvm.ptr)")
    emit_ind("^diff(%d1: i8, %d2: i8):")
    emit_ind("  %e1 = llvm.zext %d1 : i8 to i32")
    emit_ind("  %e2 = llvm.zext %d2 : i8 to i32")
    emit_ind("  %res = llvm.sub %e1, %e2 : i32")
    emit_ind("  llvm.br ^ret(%res : i32)")
    emit_ind("^ret(%rv: i32):")
    emit_ind("  llvm.return %rv : i32")
    emit_ind("}")
    emit_blank()

    # Hash functions
    emit_ind("// Pure Dolet Runtime")

    # dsl_hash_i32
    emit_ind("llvm.func @dsl_hash_i32(%arg0: i32) -> i64 {")
    emit_ind("  %0 = llvm.sext %arg0 : i32 to i64")
    emit_ind("  %c = llvm.mlir.constant(2654435761 : i64) : i64")
    emit_ind("  %1 = llvm.mul %0, %c : i64")
    emit_ind("  llvm.return %1 : i64")
    emit_ind("}")
    emit_blank()

    # dsl_hash_i64
    emit_ind("llvm.func @dsl_hash_i64(%arg0: i64) -> i64 {")
    emit_ind("  %c = llvm.mlir.constant(11400714819323198485 : i64) : i64")
    emit_ind("  %1 = llvm.mul %arg0, %c : i64")
    emit_ind("  llvm.return %1 : i64")
    emit_ind("}")
    emit_blank()

    # dsl_hash_string (FNV-1a)
    emit_ind("llvm.func @dsl_hash_string(%arg0: !llvm.ptr) -> i64 {")
    emit_ind("  %offset_basis = llvm.mlir.constant(14695981039346656037 : i64) : i64")
    emit_ind("  %prime = llvm.mlir.constant(1099511628211 : i64) : i64")
    emit_ind("  %null = llvm.mlir.zero : !llvm.ptr")
    emit_ind("  %is_null = llvm.icmp \"eq\" %arg0, %null : !llvm.ptr")
    emit_ind("  llvm.cond_br %is_null, ^null, ^body(%offset_basis, %arg0 : i64, !llvm.ptr)")
    emit_ind("^null:")
    emit_ind("  %z = llvm.mlir.constant(0 : i64) : i64")
    emit_ind("  llvm.return %z : i64")
    emit_ind("^body(%hash: i64, %ptr: !llvm.ptr):")
    emit_ind("  %char = llvm.load %ptr : !llvm.ptr -> i8")
    emit_ind("  %end = llvm.mlir.constant(0 : i8) : i8")
    emit_ind("  %is_end = llvm.icmp \"eq\" %char, %end : i8")
    emit_ind("  llvm.cond_br %is_end, ^return(%hash : i64), ^process(%hash, %ptr, %char : i64, !llvm.ptr, i8)")
    emit_ind("^process(%h: i64, %p: !llvm.ptr, %c: i8):")
    emit_ind("  %c_i64 = llvm.sext %c : i8 to i64")
    emit_ind("  %h_xor = llvm.xor %h, %c_i64 : i64")
    emit_ind("  %h_new = llvm.mul %h_xor, %prime : i64")
    emit_ind("  %one = llvm.mlir.constant(1 : i64) : i64")
    emit_ind("  %next = llvm.getelementptr %p[%one] : (!llvm.ptr, i64) -> !llvm.ptr, i8")
    emit_ind("  llvm.br ^body(%h_new, %next : i64, !llvm.ptr)")
    emit_ind("^return(%final: i64):")
    emit_ind("  llvm.return %final : i64")
    emit_ind("}")
    emit_blank()

# ==========================================
# Generate String Constants
# ==========================================
fun gen_string_constants():
    i: i32 = g_str_emitted
    while i < g_str_count:
        off8: i64 = (i as i64) * 8
        off4: i64 = (i as i64) * 4
        label: str = Memory.read_i64(g_str_labels + off8) as str
        text: str = Memory.read_i64(g_str_texts + off8) as str
        slen: i32 = Memory.read_i32(g_str_lens + off4)

        escaped: str = escape_mlir_string(text)
        # llvm.mlir.global internal constant @strN("text\00") {addr_space = 0 : i32} : !llvm.array<N x i8>
        emit_ind(Str.concat(Str.concat(Str.concat(Str.concat("llvm.mlir.global internal constant ", label), "(\""), escaped), Str.concat(Str.concat("\\00\") {addr_space = 0 : i32} : !llvm.array<", Convert.i64_to_str(slen as i64)), " x i8>")))
        i = i + 1
    g_str_emitted = g_str_count
    emit_blank()

# ==========================================
# Collect Phase: scan AST and register types
# ==========================================
fun collect_declarations(ast: i64):
    sc: i32 = nl_count(ast)
    i: i32 = 0
    # Hoisted from loop to avoid alloca-in-loop stack overflow
    node: i64 = 0
    nt: i32 = 0
    ename: str = ""
    variants: i64 = 0
    vlist: i64 = 0
    vc: i32 = 0
    j: i32 = 0
    vnode: i64 = 0
    sname: str = ""
    fields: i64 = 0
    base_class: str = ""
    s_stack_alloc: i64 = 0
    s_type_params: i64 = 0
    tf: i64 = 0
    inner_t: str = ""
    parent_fields: i64 = 0
    pfc: i32 = 0
    merged: i64 = 0
    pi: i32 = 0
    cfc: i32 = 0
    ci: i32 = 0
    smethods: i64 = 0
    smc: i32 = 0
    sj: i32 = 0
    smnode: i64 = 0
    smname: str = ""
    smret: str = ""
    smangled: str = ""
    sm_params: i64 = 0
    sm_pt: str = ""
    fname: str = ""
    ret_type: str = ""
    fparams: i64 = 0
    fpt_str: str = ""
    mangled_fn: str = ""
    isname: str = ""
    methods: i64 = 0
    mc: i32 = 0
    j2: i32 = 0
    mnode: i64 = 0
    mname: str = ""
    mret: str = ""
    mangled: str = ""
    m_params: i64 = 0
    m_pt: str = ""
    etname: str = ""
    emethods: i64 = 0
    mc2: i32 = 0
    j3: i32 = 0
    enode: i64 = 0
    emname: str = ""
    emret: str = ""
    emangled_base: str = ""
    eparams: i64 = 0
    ept_str: str = ""
    epc: i32 = 0
    epi: i32 = 0
    epn: i64 = 0
    epname: str = ""
    eptype: str = ""
    emangled: str = ""
    vname2: str = ""
    aname: str = ""
    atarget: str = ""
    total_fc: i32 = 0
    inst_fields: i64 = 0
    sfi: i32 = 0
    sf_node: i64 = 0
    sf_is_st: i64 = 0
    sf_nm: str = ""
    sf_tp: str = ""
    sf_full_nm: str = ""
    sf_def: i64 = 0
    while i < sc:
        node = nl_get(ast, i)
        nt = nd_type(node)

        # Enum declarations
        if nt == NODE_ENUM_DECL:
            ename = Memory.read_i64(node + 8) as str
            variants = Memory.read_i64(node + 16)
            vlist = mk_node_list(32)
            if variants != 0:
                vc = nl_count(variants)
                j = 0
                while j < vc:
                    vnode = nl_get(variants, j)
                    nl_add(vlist, vnode)
                    j = j + 1
            register_enum(ename, vlist)

        # Struct declarations
        if nt == NODE_STRUCT_DECL:
            sname = Memory.read_i64(node + 8) as str
            fields = Memory.read_i64(node + 16)
            base_class = Memory.read_i64(node + 32) as str
            s_stack_alloc = Memory.read_i64(node + 56)

            s_type_params = Memory.read_i64(node + 24)
            if s_type_params != 0:
                register_generic(sname, s_type_params)

            if s_stack_alloc == 2:
                if fields != 0:
                    if nl_count(fields) > 0:
                        tf = nl_get(fields, 0)
                        inner_t = Memory.read_i64(tf + 16) as str
                        register_transparent(sname, inner_t)
            else:
                if s_stack_alloc == 3:
                    register_heap_struct(sname)
                if str_eq(base_class, "") == 0:
                    parent_fields = get_struct_fields(base_class)
                    if parent_fields != 0:
                        pfc = nl_count(parent_fields)
                        merged = mk_node_list(512)
                        pi = 0
                        while pi < pfc:
                            nl_add(merged, nl_get(parent_fields, pi))
                            pi = pi + 1
                        if fields != 0:
                            cfc = nl_count(fields)
                            ci = 0
                            while ci < cfc:
                                nl_add(merged, nl_get(fields, ci))
                                ci = ci + 1
                        fields = merged
                    register_parent_struct(sname, base_class)
                if fields != 0:
                    # Separate instance fields from static fields
                    total_fc = nl_count(fields)
                    inst_fields = mk_node_list(512)
                    sfi = 0
                    while sfi < total_fc:
                        sf_node = nl_get(fields, sfi)
                        sf_is_st = Memory.read_i64(sf_node + 48)
                        if sf_is_st == 1:
                            sf_nm = Memory.read_i64(sf_node + 8) as str
                            sf_tp = Memory.read_i64(sf_node + 16) as str
                            if str_eq(sf_tp, "") == 1:
                                sf_tp = "i64"
                            sf_full_nm = Str.concat(Str.concat(sname, "__"), sf_nm)
                            sf_def = Memory.read_i64(sf_node + 32)
                            if sf_def != 0:
                                register_static_field_with_default(sf_full_nm, sf_tp, sf_def)
                            else:
                                register_static_field(sf_full_nm, sf_tp)
                        else:
                            nl_add(inst_fields, sf_node)
                        sfi = sfi + 1
                    register_struct(sname, inst_fields)
                else:
                    register_struct(sname, mk_node_list(4))
                smethods = Memory.read_i64(node + 40)
                if smethods != 0:
                    smc = nl_count(smethods)
                    sj = 0
                    while sj < smc:
                        smnode = nl_get(smethods, sj)
                        smname = Memory.read_i64(smnode + 8) as str
                        smret = Memory.read_i64(smnode + 24) as str
                        smangled = Str.concat(Str.concat(sname, "_"), smname)
                        sm_params = Memory.read_i64(smnode + 16)
                        sm_pt = build_param_types_str_no_self(sm_params)
                        register_fun_sig_with_params(smangled, smret, sm_pt)
                        register_impl_method(sname, smname, smnode)
                        sj = sj + 1

        # Function definitions
        if nt == NODE_FUN_DEF:
            fname = Memory.read_i64(node + 8) as str
            ret_type = Memory.read_i64(node + 24) as str
            fparams = Memory.read_i64(node + 16)
            fpt_str = build_param_types_str(fparams)
            mangled_fn = register_overload(fname, fpt_str)
            register_fun_sig_with_params(mangled_fn, ret_type, fpt_str)
            # Phase 4.5: track generic functions for monomorphization
            f_type_params: i64 = Memory.read_i64(node + 40)
            if f_type_params != 0:
                register_gen_fn(fname, node)

        # Impl blocks — the canonical extension form. Now also registers
        # OVERLOADS the same way the legacy extend-block path did (e.g.
        # `impl list:` with multiple `fun set(self, idx, value: i8/i16/...)`
        # produces `list_set__i8`, `list_set__i16`, ... mangled symbols
        # instead of colliding on `list_set`).
        if nt == NODE_IMPL_BLOCK:
            isname = Memory.read_i64(node + 8) as str
            methods = Memory.read_i64(node + 16)
            if methods != 0:
                mc = nl_count(methods)
                j2 = 0
                while j2 < mc:
                    mnode = nl_get(methods, j2)
                    mname = Memory.read_i64(mnode + 8) as str
                    mret = Memory.read_i64(mnode + 24) as str
                    mangled_base = Str.concat(Str.concat(isname, "_"), mname)
                    m_params = Memory.read_i64(mnode + 16)
                    m_pt = build_param_types_str_no_self(m_params)
                    mangled = register_overload(mangled_base, m_pt)
                    register_fun_sig_with_params(mangled, mret, m_pt)
                    register_impl_method(isname, mname, mnode)
                    j2 = j2 + 1

        # Extend blocks
        if nt == NODE_EXTEND_BLOCK:
            etname = Memory.read_i64(node + 8) as str
            # Nested namespace form `extend Outer.Inner:` — translate
            # the dot to underscore so the registered mangled name
            # matches what gen_extend_block emits and what the call
            # site looks up. Without this the registry holds
            # `Outer.Inner_X` (with a dot) but we look up
            # `Outer_Inner_X` (with underscore) and miss.
            etname = str_replace(etname, ".", "_")
            emethods = Memory.read_i64(node + 16)
            if emethods != 0:
                mc2 = nl_count(emethods)
                j3 = 0
                while j3 < mc2:
                    enode = nl_get(emethods, j3)
                    emname = Memory.read_i64(enode + 8) as str
                    emret = Memory.read_i64(enode + 24) as str
                    emangled_base = Str.concat(Str.concat(etname, "_"), emname)
                    eparams = Memory.read_i64(enode + 16)
                    ept_str = ""
                    if eparams != 0:
                        epc = nl_count(eparams)
                        epi = 0
                        while epi < epc:
                            epn = nl_get(eparams, epi)
                            epname = Memory.read_i64(epn + 8) as str
                            if str_eq(epname, "self") == 0:
                                eptype = Memory.read_i64(epn + 16) as str
                                if Memory.strlen(ept_str) > 0:
                                    ept_str = Str.concat(ept_str, Str.concat(",", eptype))
                                else:
                                    ept_str = eptype
                            epi = epi + 1
                    emangled = register_overload(emangled_base, ept_str)
                    register_fun_sig_with_params(emangled, emret, ept_str)
                    register_impl_method(etname, emname, enode)
                    # Generic method (`attach T: fun m<U>(...)`) — register
                    # it in the generic-fn table under key `T_m` so the
                    # monomorphizer can clone it per call-site type-arg.
                    e_tp = Memory.read_i64(enode + 40)
                    if e_tp != 0:
                        register_gen_fn(emangled_base, enode)
                    j3 = j3 + 1

        # Extern blocks
        if nt == NODE_EXTERN_BLOCK:
            register_extern_sigs(node)

        # Variable declarations
        if nt == NODE_VAR_DECL:
            vname2 = Memory.read_i64(node + 16) as str
            register_global_var(vname2, node)

        # Type alias
        if nt == NODE_TYPE_ALIAS:
            aname = Memory.read_i64(node + 8) as str
            atarget = Memory.read_i64(node + 16) as str
            register_alias(aname, atarget)

        i = i + 1

# ==========================================
# Collect String Literals from AST
# ==========================================
fun collect_strings_list(nlist: i64):
    if nlist == 0:
        return
    lc: i32 = nl_count(nlist)
    li: i32 = 0
    while li < lc:
        collect_strings(nl_get(nlist, li))
        li = li + 1

fun collect_strings(node: i64):
    if node == 0:
        return
    nt: i32 = nd_type(node)

    if nt == NODE_STR_LIT:
        text: str = Memory.read_i64(node + 8) as str
        gen_string_const(text)
        return

    if nt == NODE_FSTRING:
        collect_strings_list(Memory.read_i64(node + 8))
        return

    # Recurse into all known node structures
    if nt == NODE_VAR_DECL:
        collect_strings(Memory.read_i64(node + 24))
        return
    if nt == NODE_ASSIGN or nt == NODE_FIELD_ASSIGN:
        collect_strings(Memory.read_i64(node + 16))
        return
    if nt == NODE_NESTED_FIELD_ASSIGN:
        collect_strings(Memory.read_i64(node + 8))
        collect_strings(Memory.read_i64(node + 16))
        return
    if nt == NODE_BINARY_OP or nt == NODE_COMPARISON or nt == NODE_LOGICAL_OP:
        collect_strings(Memory.read_i64(node + 16))
        collect_strings(Memory.read_i64(node + 24))
        return
    if nt == NODE_UNARY_OP:
        collect_strings(Memory.read_i64(node + 16))
        return
    if nt == NODE_CAST:
        collect_strings(Memory.read_i64(node + 8))
        return
    if nt == NODE_PAREN:
        collect_strings(Memory.read_i64(node + 8))
        return
    if nt == NODE_RETURN:
        collect_strings(Memory.read_i64(node + 8))
        return
    if nt == NODE_FUN_CALL or nt == NODE_BUILTIN_CALL:
        collect_strings_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_STATIC_METHOD or nt == NODE_NS_FUN_CALL:
        collect_strings_list(Memory.read_i64(node + 24))
        return
    if nt == NODE_NS_STATIC_METHOD:
        collect_strings_list(Memory.read_i64(node + 32))
        return
    if nt == NODE_INST_METHOD:
        collect_strings_list(Memory.read_i64(node + 24))
        return
    if nt == NODE_FUN_DEF:
        collect_strings_list(Memory.read_i64(node + 32))
        return
    if nt == NODE_IF:
        collect_strings(Memory.read_i64(node + 8))
        collect_strings_list(Memory.read_i64(node + 16))
        collect_strings_list(Memory.read_i64(node + 24))
        return
    if nt == NODE_WHILE:
        collect_strings(Memory.read_i64(node + 8))
        collect_strings_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_FOR:
        collect_strings(Memory.read_i64(node + 16))
        collect_strings(Memory.read_i64(node + 24))
        collect_strings_list(Memory.read_i64(node + 32))
        return
    if nt == NODE_FOR_EACH:
        collect_strings(Memory.read_i64(node + 32))
        collect_strings_list(Memory.read_i64(node + 40))
        return
    if nt == NODE_BLOCK:
        collect_strings_list(Memory.read_i64(node + 8))
        return
    if nt == NODE_ARRAY_LIT or nt == NODE_LIST_LIT:
        collect_strings_list(Memory.read_i64(node + 8))
        return
    if nt == NODE_TERNARY:
        collect_strings(Memory.read_i64(node + 8))
        collect_strings(Memory.read_i64(node + 16))
        collect_strings(Memory.read_i64(node + 24))
        return
    if nt == NODE_IMPL_BLOCK or nt == NODE_EXTEND_BLOCK:
        collect_strings_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_STRUCT_DECL:
        collect_strings_list(Memory.read_i64(node + 40))
        return
    if nt == NODE_METHOD_DEF:
        collect_strings_list(Memory.read_i64(node + 32))
        return
    if nt == NODE_MATCH:
        collect_strings(Memory.read_i64(node + 8))
        collect_strings_list(Memory.read_i64(node + 16))
        collect_strings_list(Memory.read_i64(node + 24))
        return
    if nt == NODE_CASE:
        collect_strings_list(Memory.read_i64(node + 16))
        return
    if nt == NODE_STRUCT_INST:
        # field_vals node_list at +16, each field_val has value expr at +16
        fvl: i64 = Memory.read_i64(node + 16)
        if fvl != 0:
            fvc: i32 = nl_count(fvl)
            fi: i32 = 0
            while fi < fvc:
                fv: i64 = nl_get(fvl, fi)
                collect_strings(Memory.read_i64(fv + 16))
                fi = fi + 1
        return
    if nt == NODE_STRUCT_FIELD:
        # default value at +24
        collect_strings(Memory.read_i64(node + 24))
        return
    if nt == NODE_FIELD_VAL:
        # Keyword arg in struct construction: name at +8, value at +16
        collect_strings(Memory.read_i64(node + 16))
        return

fun collect_all_strings(ast: i64):
    sc: i32 = nl_count(ast)
    i: i32 = 0
    while i < sc:
        collect_strings(nl_get(ast, i))
        i = i + 1

# ==========================================
# Compile-time literal value for a global initializer
# ==========================================
# Returns the MLIR constant value string for a global's initializer node
# (e.g. "4", "-7", "3.5", "1"), or "" when the initializer is not a
# compile-time literal (expression, call, etc.) and therefore still needs
# the runtime-store init path. Mirrors gen_static_field_decls so globals
# are correctly initialized even when the program defines its own main()
# (the synthetic-main runtime stores only run when there is no user main).
fun global_init_const_value(init_node: i64, vtype: str) -> str:
    if init_node == 0:
        return ""
    nt: i32 = nd_type(init_node)

    # Unwrap unary minus on a numeric literal: -7, -2.25
    if nt == NODE_UNARY_OP:
        op_str: str = Memory.read_i64(init_node + 8) as str
        if str_eq(op_str, "-") == 1:
            operand: i64 = Memory.read_i64(init_node + 16)
            ont: i32 = nd_type(operand)
            if ont == NODE_INT_LIT:
                v: i64 = Memory.read_i64(operand + 8)
                if is_float_type(vtype) == 1:
                    return Str.concat(Convert.i64_to_str(0 - v), ".0")
                return Convert.i64_to_str(0 - v)
            if ont == NODE_FLOAT_LIT:
                fs: str = Memory.read_i64(operand + 8) as str
                return Str.concat("-", fs)
        return ""

    if nt == NODE_INT_LIT:
        v2: i64 = Memory.read_i64(init_node + 8)
        # int literal assigned to a float-typed global (e.g. X: f64 = 5)
        if is_float_type(vtype) == 1:
            return Str.concat(Convert.i64_to_str(v2), ".0")
        return Convert.i64_to_str(v2)

    if nt == NODE_FLOAT_LIT:
        return Memory.read_i64(init_node + 8) as str

    if nt == NODE_BOOL_LIT:
        bv: i64 = Memory.read_i64(init_node + 8)
        if bv != 0:
            return "1"
        return "0"

    return ""

# ==========================================
# Generate Global Variable Declarations
# ==========================================
fun gen_global_var_decls():
    if g_global_var_count == 0:
        return
    emit_ind("// Global variable declarations")
    i: i32 = 0
    while i < g_global_var_count:
        off: i64 = (i as i64) * 8
        gname: str = Memory.read_i64(g_global_var_names + off) as str
        gnode: i64 = Memory.read_i64(g_global_var_nodes + off)

        vtype: str = Memory.read_i64(gnode + 8) as str

        # If type is empty (const without annotation), infer from value expression
        if str_eq(vtype, "") == 1:
            val_node_infer: i64 = Memory.read_i64(gnode + 24)
            if val_node_infer != 0:
                vtype = infer_expr_type(val_node_infer)
            if str_eq(vtype, "") == 1 or str_eq(vtype, "unknown") == 1:
                vtype = "i64"

        mt: str = mlir_type(vtype)

        # Create unique mlir name
        mname: str = gname
        g_is_const: i32 = Memory.read_i64(gnode + 48) as i32
        add_variable(gname, mname, vtype, 2, g_is_const)

        # Compile-time literal initializer baked directly into the global so
        # it is correct regardless of whether the program defines main().
        ginit_node: i64 = Memory.read_i64(gnode + 24)
        glit: str = global_init_const_value(ginit_node, vtype)

        # Emit global declaration
        emit_ind(Str.concat(Str.concat(Str.concat("llvm.mlir.global internal @", mname), " () {addr_space = 0 : i32} : "), Str.concat(mt, " {")))
        if is_string_type(vtype) == 1:
            emit_ind("  %0 = llvm.mlir.zero : !llvm.ptr")
            emit_ind("  llvm.return %0 : !llvm.ptr")
        elif is_int_type(vtype) == 1:
            iv: str = "0"
            if str_eq(glit, "") == 0:
                iv = glit
            emit_ind(Str.concat(Str.concat(Str.concat("  %0 = llvm.mlir.constant(", iv), Str.concat(" : ", mt)), Str.concat(") : ", mt)))
            emit_ind(Str.concat(Str.concat("  llvm.return %0 : ", mt), ""))
        elif is_float_type(vtype) == 1:
            fv: str = "0.0"
            if str_eq(glit, "") == 0:
                fv = glit
            emit_ind(Str.concat(Str.concat(Str.concat("  %0 = llvm.mlir.constant(", fv), Str.concat(" : ", mt)), Str.concat(") : ", mt)))
            emit_ind(Str.concat(Str.concat("  llvm.return %0 : ", mt), ""))
        elif str_eq(mt, "i1") == 1:
            bvs: str = "0"
            if str_eq(glit, "") == 0:
                bvs = glit
            emit_ind(Str.concat(Str.concat("  %0 = llvm.mlir.constant(", bvs), " : i1) : i1"))
            emit_ind("  llvm.return %0 : i1")
        else:
            emit_ind(Str.concat("  %0 = llvm.mlir.zero : ", mt))
            emit_ind(Str.concat("  llvm.return %0 : ", mt))
        emit_ind("}")
        i = i + 1
    emit_blank()

# ==========================================
# Generate Struct Static Field Declarations
# ==========================================
fun gen_static_field_decls():
    if g_static_field_count == 0:
        return
    emit_ind("// Struct static field declarations")
    i: i32 = 0
    while i < g_static_field_count:
        off: i64 = (i as i64) * 8
        sf_name: str = Memory.read_i64(g_sf_names + off) as str
        sf_type: str = Memory.read_i64(g_sf_types + off) as str
        sf_def: i64 = Memory.read_i64(g_sf_defaults + off)
        mt: str = mlir_type(sf_type)
        add_variable(sf_name, sf_name, sf_type, 2, 0)
        emit_ind(Str.concat(Str.concat(Str.concat("llvm.mlir.global internal @", sf_name), " () {addr_space = 0 : i32} : "), Str.concat(mt, " {")))
        # Check for non-zero default literal values
        def_int_val: str = "0"
        def_float_val: str = "0.0"
        if sf_def != 0:
            def_nt: i32 = nd_type(sf_def)
            if def_nt == NODE_INT_LIT:
                def_int_val = Convert.i64_to_str(Memory.read_i64(sf_def + 8))
            elif def_nt == NODE_FLOAT_LIT:
                def_float_val = Memory.read_i64(sf_def + 8) as str
        if is_string_type(sf_type) == 1:
            emit_ind("  %0 = llvm.mlir.zero : !llvm.ptr")
            emit_ind("  llvm.return %0 : !llvm.ptr")
        elif is_int_type(sf_type) == 1:
            emit_ind(Str.concat(Str.concat("  %0 = llvm.mlir.constant(", def_int_val), Str.concat(Str.concat(" : ", mt), Str.concat(") : ", mt))))
            emit_ind(Str.concat("  llvm.return %0 : ", mt))
        elif is_float_type(sf_type) == 1:
            emit_ind(Str.concat(Str.concat("  %0 = llvm.mlir.constant(", def_float_val), Str.concat(Str.concat(" : ", mt), Str.concat(") : ", mt))))
            emit_ind(Str.concat("  llvm.return %0 : ", mt))
        else:
            emit_ind(Str.concat("  %0 = llvm.mlir.zero : ", mt))
            emit_ind(Str.concat("  llvm.return %0 : ", mt))
        emit_ind("}")
        i = i + 1
    emit_blank()

# ==========================================
# Generate Functions
# ==========================================
fun gen_functions(ast: i64):
    sc: i32 = nl_count(ast)
    i: i32 = 0
    while i < sc:
        node: i64 = nl_get(ast, i)
        nt: i32 = nd_type(node)

        if nt == NODE_EXTERN_BLOCK:
            if ts_extern_block_has_reachable(node) == 1:
                gen_extern_block(node)
        elif nt == NODE_STRUCT_DECL:
            sdbg: str = Memory.read_i64(node + 8) as str
            # Skip @transparent structs — they have no MLIR representation
            s_sa: i64 = Memory.read_i64(node + 56)
            if s_sa != 2:
                if ts_is_reachable(sdbg) == 1:
                    if is_fn_emitted(sdbg) == 0:
                        mark_fn_emitted(sdbg)
                        gen_struct_inline_methods(node)
        elif nt == NODE_FUN_DEF:
            ts_fname: str = Memory.read_i64(node + 8) as str
            # Skip generic functions (`fun f<T>(...)`) — their body has
            # unresolved T refs. The monomorphizer emits a concrete clone
            # (`f__i32`) as a separate top-level function per call-site.
            f_tp: i64 = Memory.read_i64(node + 40)
            if f_tp == 0:
                if ts_is_reachable(ts_fname) == 1:
                    gen_fun_def(node)
        elif nt == NODE_IMPL_BLOCK:
            ts_sname: str = Memory.read_i64(node + 8) as str
            if ts_is_reachable(ts_sname) == 1:
                gen_impl_block(node)
        elif nt == NODE_EXTEND_BLOCK:
            ts_tname: str = Memory.read_i64(node + 8) as str
            if ts_is_reachable(ts_tname) == 1:
                gen_extend_block(node)
        i = i + 1

# ==========================================
# Generate Main Body (top-level statements)
# ==========================================
fun gen_main_body(ast: i64):
    sc: i32 = nl_count(ast)
    i: i32 = 0
    while i < sc:
        node: i64 = nl_get(ast, i)
        nt: i32 = nd_type(node)

        # Skip declarations (already generated)
        if nt == NODE_FUN_DEF:
            i = i + 1
        elif nt == NODE_STRUCT_DECL:
            i = i + 1
        elif nt == NODE_ENUM_DECL:
            i = i + 1
        elif nt == NODE_IMPL_BLOCK:
            i = i + 1
        elif nt == NODE_EXTEND_BLOCK:
            i = i + 1
        elif nt == NODE_EXTERN_BLOCK:
            i = i + 1
        elif nt == NODE_TRAIT_DECL:
            i = i + 1
        elif nt == NODE_TYPE_ALIAS:
            i = i + 1
        elif nt == NODE_IMPORT:
            i = i + 1
        elif nt == NODE_ANNOT_DEF:
            i = i + 1
        else:
            # Top-level statement — generate in main
            gen_statement(node)
            i = i + 1

# ==========================================
# Check if AST has user-defined main
# ==========================================
fun has_user_main(ast: i64) -> i32:
    sc: i32 = nl_count(ast)
    i: i32 = 0
    while i < sc:
        node: i64 = nl_get(ast, i)
        nt: i32 = nd_type(node)
        if nt == NODE_FUN_DEF:
            fname: str = Memory.read_i64(node + 8) as str
            if str_eq(fname, "main") == 1:
                return 1
        i = i + 1
    return 0

# ==========================================
# Generate the global-initializer function (@__dolet_global_init)
# ==========================================
# When the program defines its own main(), the synthetic-main block below
# is skipped — and with it, the top-level statements that run non-constant
# global initializers (e.g. `g: AtomicI64 = AtomicI64.new(0)`, or any
# `g = some_call()`). Those globals would stay zero-initialized and crash
# at first use. To fix this we emit the top-level statements into a
# dedicated void function `@__dolet_global_init` and inject a call to it at
# the start of user main (see gen_fun_def). Literal-valued globals are still
# baked as MLIR constants in gen_global_var_decls; this function runs the
# remaining runtime initializers + any other top-level code, once, in order.
fun gen_global_init_fn(ast: i64):
    g_tmp_counter = 0
    emit_ind("llvm.func @__dolet_global_init() {")
    indent_inc()

    # Mirror the synthetic-main prologue: hoist allocas to entry, bracket
    # with an arena frame so top-level `+`/formatters are auto-freed.
    old_entry_active_g:     i32 = g_entry_active
    old_entry_count_g:      i32 = g_entry_count
    old_entry_insert_pos_g: i32 = g_entry_insert_pos
    g_entry_active     = 1
    g_entry_count      = 0
    g_entry_insert_pos = g_out_count

    old_arena_g: i32 = g_arena_emit
    g_arena_emit = 1
    emit_ind("%__arena_frame = llvm.call @_scope_arena_push() : () -> i64")

    # Top-level statements in source order (global var-decls with runtime
    # initializers are emitted inline here, preserving execution order).
    gen_main_body(ast)

    flush_entry_allocas()
    g_entry_active     = old_entry_active_g
    g_entry_count      = old_entry_count_g
    g_entry_insert_pos = old_entry_insert_pos_g

    emit_ind("llvm.call @_scope_arena_pop(%__arena_frame) : (i64) -> ()")
    emit_ind("llvm.return")
    g_arena_emit = old_arena_g

    indent_dec()
    emit_ind("}")

# ==========================================
# Main Generate Function
# ==========================================
fun generate(ast: i64) -> str:
    gen_total_start_ms: i64 = TimeOps.time_now_ms()
    init_all_registries()
    gen_init_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] init: ", Str.concat(Convert.i64_to_str(gen_init_end_ms - gen_total_start_ms), " ms")))

    # Phase 1: Collect declarations
    gen_decl_start_ms: i64 = TimeOps.time_now_ms()
    collect_declarations(ast)
    gen_decl_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] declarations: ", Str.concat(Convert.i64_to_str(gen_decl_end_ms - gen_decl_start_ms), " ms")))

    # Phase 1.1: Validate explicit `attach Trait for Type:` blocks —
    # every trait method must be implemented on the target type.
    gen_analysis_start_ms: i64 = TimeOps.time_now_ms()
    check_explicit_trait_impls(ast)

    # Phase 1.25: Monomorphize user generics (B3 Phase 2)
    monomorphize_pass(ast)

    # Phase 1.5: Tree shaking (opt-in)
    run_tree_shaking(ast)
    gen_analysis_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] validate/mono/tree: ", Str.concat(Convert.i64_to_str(gen_analysis_end_ms - gen_analysis_start_ms), " ms")))

    # Phase 2: Collect string literals
    gen_strings_start_ms: i64 = TimeOps.time_now_ms()
    collect_all_strings(ast)
    gen_strings_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] collect strings: ", Str.concat(Convert.i64_to_str(gen_strings_end_ms - gen_strings_start_ms), " ms")))

    # Phase 3: Emit module
    emit("// MLIR generated by Dolet Self-Hosting Compiler")
    emit("// Target: MLIR -> LLVM IR -> Machine Code")
    emit("")
    emit("module {")
    indent_inc()

    # String constants
    gen_prelude_start_ms: i64 = TimeOps.time_now_ms()
    gen_string_constants()

    # Platform-specific helpers (e.g., _fltused, __chkstk) are now in
    # library/sys/<platform>/runtime_helpers.obj — linked externally, not emitted here.

    # Runtime declarations
    gen_runtime_decls()

    # Global variable declarations
    gen_global_var_decls()

    # Struct static field declarations
    gen_static_field_decls()
    gen_prelude_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] module prelude: ", Str.concat(Convert.i64_to_str(gen_prelude_end_ms - gen_prelude_start_ms), " ms")))

    # User-defined functions
    gen_functions_start_ms: i64 = TimeOps.time_now_ms()
    gen_functions(ast)
    gen_functions_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] functions: ", Str.concat(Convert.i64_to_str(gen_functions_end_ms - gen_functions_start_ms), " ms")))

    # Main function (if user didn't define one)
    gen_main_start_ms: i64 = TimeOps.time_now_ms()
    if has_user_main(ast) == 0:
        g_tmp_counter = 0
        emit_ind("llvm.func @main() -> i32 {")
        indent_inc()

        # Activate entry block buffer so every alloca inside main (struct
        # locals, scratch slots, arena frame handle) ends up at main's
        # single function-entry prologue — one `sub rsp, N` — instead of
        # being scattered mid-function. Without this, a caller-side
        # `llvm.alloca` between a struct-returning call and the ensuing
        # 13-field copy loop runs `sub rsp, N` on top of the callee's
        # just-popped alloca, stomping the very bytes we're about to
        # read. That's the root of the test2/test4 segfaults and of the
        # dangling pointers that manifested as RAM "leaks" in test5/6.
        old_entry_active_m:     i32 = g_entry_active
        old_entry_count_m:      i32 = g_entry_count
        old_entry_insert_pos_m: i32 = g_entry_insert_pos
        g_entry_active     = 1
        g_entry_count      = 0
        g_entry_insert_pos = g_out_count

        # Arena prologue for main — top-level `+` calls benefit, and the
        # per-iteration brackets inside while loops give per-frame reset.
        old_arena_main: i32 = g_arena_emit
        g_arena_emit = 1
        emit_ind("%__arena_frame = llvm.call @_scope_arena_push() : () -> i64")

        # Note: we deliberately do NOT push a "main" frame here. The first
        # statements inside main are the zero-init stores for every global
        # `g_x: T = 0` declaration (including the frame stack's own
        # globals), which would clobber any frame pushed before them.
        # Without an injection point between the init block and user code,
        # frames pushed by user functions called from main are sufficient
        # — the panic prefix already pinpoints the panic site, so a
        # top-level panic just shows no extra trace lines.

        # Generate all top-level statements in source order
        # (var decls with init values are generated inline, preserving execution order)
        gen_main_body(ast)

        # Flush hoisted allocas into main's entry block. Because we
        # recorded g_entry_insert_pos BEFORE emitting the arena push,
        # the flush slides allocas in ABOVE the push — final prologue
        # order is: allocas → arena push → body.
        flush_entry_allocas()
        g_entry_active     = old_entry_active_m
        g_entry_count      = old_entry_count_m
        g_entry_insert_pos = old_entry_insert_pos_m

        # Arena epilogue + return
        c0: str = emit_const_i32(0)
        emit_ind("llvm.call @_scope_arena_pop(%__arena_frame) : (i64) -> ()")
        emit_ind(Str.concat(Str.concat("llvm.return ", c0), " : i32"))
        g_arena_emit = old_arena_main

        indent_dec()
        emit_ind("}")
    else:
        # The program defines its own main(). Emit a dedicated init function
        # for the top-level statements (non-constant global initializers) and
        # inject a call to it at the start of user main (gen_fun_def).
        gen_global_init_fn(ast)
    gen_main_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] main/global init: ", Str.concat(Convert.i64_to_str(gen_main_end_ms - gen_main_start_ms), " ms")))

    # Emit any late string constants added during function generation
    if g_str_emitted < g_str_count:
        gen_string_constants()

    indent_dec()
    emit("}")

    # Join all output lines — O(n) bulk copy instead of O(n²) concat
    gen_join_start_ms: i64 = TimeOps.time_now_ms()
    total_len: i64 = 0
    i: i32 = 0
    while i < g_out_count:
        total_len = total_len + Memory.strlen(get_output_line(i))
        if i > 0:
            total_len = total_len + 1
        i = i + 1
    buf: i64 = Memory.malloc(total_len + 1)
    pos: i64 = 0
    i = 0
    line: str = ""
    llen: i64 = 0
    while i < g_out_count:
        if i > 0:
            Memory.write_i8(buf + pos, 10 as i8)
            pos = pos + 1
        line = get_output_line(i)
        llen = Memory.strlen(line)
        if llen > 0:
            Memory.copy(buf + pos, line as i64, llen)
            pos = pos + llen
        i = i + 1
    Memory.write_i8(buf + pos, 0 as i8)
    gen_join_end_ms: i64 = TimeOps.time_now_ms()
    IOOps.io_println(Str.concat("[gen] join output: ", Str.concat(Convert.i64_to_str(gen_join_end_ms - gen_join_start_ms), " ms")))
    IOOps.io_println(Str.concat("[gen] total: ", Str.concat(Convert.i64_to_str(gen_join_end_ms - gen_total_start_ms), " ms")))
    return buf as str
