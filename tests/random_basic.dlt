import std

# Test Random.X (default LCG, fast) and Random.Secure.X (stronger PRNG).
# Both are pure CPU — no OS, work on bare metal.

fun do_test():
    # ---- Default: Random.X = LCG, fast ----
    Random.seed(42 as i64)
    print("--- Random.range(1, 100) x 5 ---")
    print(Random.range(1, 100))
    print(Random.range(1, 100))
    print(Random.range(1, 100))
    print(Random.range(1, 100))
    print(Random.range(1, 100))

    print("--- Random.next_f64() x 3 ---")
    print(Random.next_f64())
    print(Random.next_f64())
    print(Random.next_f64())

    Random.seed(42 as i64)
    print("--- after Random.seed(42) ---")
    print(Random.range(1, 100))    # same as first roll above

    # ---- Secure: Random.Secure.X = stronger PRNG ----
    Random.Secure.seed(42 as i64)
    print("--- Random.Secure.range(1, 100) x 5 ---")
    print(Random.Secure.range(1, 100))
    print(Random.Secure.range(1, 100))
    print(Random.Secure.range(1, 100))
    print(Random.Secure.range(1, 100))
    print(Random.Secure.range(1, 100))

    Random.Secure.seed(42 as i64)
    print("--- after Random.Secure.seed(42) ---")
    print(Random.Secure.range(1, 100))   # same as first secure roll

    # ---- Explicit-state Lcg instance ----
    g: Lcg = Lcg.new(7 as i64)
    print("--- explicit Lcg.new(7).range_i32(0, 9) x 3 ---")
    print(g.range_i32(0, 9))
    print(g.range_i32(0, 9))
    print(g.range_i32(0, 9))

do_test()
