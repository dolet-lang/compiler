import std

# Zero-arg lambda with the new fun(...) syntax — `fun()` is the
# spelled-out version of the old `||`. At primary-expression position
# `fun(...)` is unambiguously a lambda value.

# Form 1: bare local
fun test1():
    f: fun() -> i32 = fun() -> i32 42
    print(f())   # 42

# Form 2: heap return
fun make_thunk() -> @heap fun() -> i32:
    return fun() -> i32 99

fun test2():
    g: @heap fun() -> i32 = make_thunk()
    print(g())   # 99

# Form 3: zero-arg, void return, captures local
fun test3():
    msg: str = "hi"
    h: fun() = fun() print(msg)
    h()
    h()

# Form 4: still parse `a || b` as logical OR after operands — the
# tokenizer emits TK_OR, but at infix position the parser handles it
# as logical-or, not as a zero-arg lambda.
fun test4():
    a: bool = true
    b: bool = false
    if a || b:
        print("either")

test1()
test2()
test3()
test4()
