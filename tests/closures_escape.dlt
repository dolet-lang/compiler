import std

# Escape test: a closure returned from a factory function.
# Returning a closure means it ESCAPES the enclosing fn — must be
# heap-allocated. The user marks the return type with `@heap` to
# opt into heap. Without `@heap`, the compiler refuses to compile.

fun make_adder(n: i32) -> @heap fun(i32) -> i32:
    return fun(x: i32) -> i32 x + n

add5: @heap fun(i32) -> i32 = make_adder(5)
add100: @heap fun(i32) -> i32 = make_adder(100)

print("add5(10)=" + Convert.i32_to_str(add5(10)))      # 15
print("add100(50)=" + Convert.i32_to_str(add100(50)))  # 150
print("add5(3)=" + Convert.i32_to_str(add5(3)))        # 8 (verify same closure works again)
