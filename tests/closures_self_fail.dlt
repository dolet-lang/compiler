import std

# Must-fail: self-capture in a method-local lambda. The compiler should
# refuse to compile and direct the user to the workaround pattern (copy
# field to local first). Without this, the lifted lambda silently
# generates an empty body and segfaults at the call site.

struct Counter:
    n: i32

extend Counter:
    fun bind_inc(self) -> @heap fun(i32) -> i32:
        return |delta: i32| -> i32 self.n + delta

fun do_test():
    c: Counter = Counter(n=10)
    f: @heap fun(i32) -> i32 = c.bind_inc()
    print(f(5))

do_test()
