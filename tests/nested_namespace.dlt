import std

# `extend Outer.Inner:` declares a formal nested namespace. Methods
# get mangled as Outer_Inner_method instead of Inner_method, and the
# call site `Outer.Inner.X(...)` resolves to that exact name. This
# is Java/C#-style nested types — Inner is NOT a top-level struct,
# it's purely the nested label inside Outer.

struct Outer:
    _: i32

extend Outer:
    static fun greet() -> str:
        return "Outer.greet"

# No `struct Inner:` — Inner exists only as a nested label here.
extend Outer.Inner:
    static fun greet() -> str:
        return "Outer.Inner.greet"

    static fun add(a: i32, b: i32) -> i32:
        return a + b

    static fun pi() -> f64:
        return 3.14159265

# Two levels of nesting — Outer.Tools.helper(...).
extend Outer.Tools:
    static fun shout(s: str) -> str:
        return s + "!"

fun do_test():
    # 2-level (regular static)
    print(Outer.greet())                  # "Outer.greet"

    # 3-level — formal nested namespace
    print(Outer.Inner.greet())            # "Outer.Inner.greet"
    print(Outer.Inner.add(3, 4))          # 7
    print(Outer.Inner.pi())               # 3.14159265

    # Different nested namespace under same Outer
    print(Outer.Tools.shout("hello"))     # "hello!"

do_test()
