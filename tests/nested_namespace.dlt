import std

# Composition-based namespacing: a struct holds a static field of
# another struct's type, and calls of the form `A.b.method(...)`
# dispatch directly to `B.method(...)` via the codegen's Path 3.
# This replaces the older (now-removed) `struct A.B:` / `group A.B:`
# syntax: same ergonomic surface, no special parser/mangler magic.

struct Inner:
    _placeholder: i32

    static fun greet() -> str:
        return "Outer.inner.greet"

    static fun add(a: i32, b: i32) -> i32:
        return a + b

    static fun pi() -> f64:
        return 3.14159265

struct Tools:
    _placeholder: i32

    static fun shout(s: str) -> str:
        return s + "!"

struct Outer:
    _placeholder: i32

    # `= Inner()` / `= Tools()` follows the standard OOP convention for
    # static fields. The slot is zero-initialized via the trivial ctor;
    # Path 3 dispatch only uses the field's TYPE today, but the explicit
    # init makes the intent unambiguous to every reader.
    static inner: Inner = Inner()
    static tools: Tools = Tools()

    static fun greet() -> str:
        return "Outer.greet"

fun do_test():
    # 2-level static (regular static method on Outer)
    print(Outer.greet())                  # "Outer.greet"

    # 3-level via composition — Path 3 dispatch
    print(Outer.inner.greet())            # "Outer.inner.greet"
    print(Outer.inner.add(3, 4))          # 7
    print(Outer.inner.pi())               # 3.14159265

    # Different namespaced helper under same Outer
    print(Outer.tools.shout("hello"))     # "hello!"

do_test()
