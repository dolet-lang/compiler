struct Counter:
    value: i32 = 0

attach Counter:
    fun add(self, amount: i32) -> i32:
        amount = amount + 2
        return self.value + amount

fun adjusted(value: i32) -> i32:
    value = value * 2
    value = value + 1
    return value

fun main() -> i32:
    counter: Counter = Counter(value=10)
    if adjusted(20) != 41:
        return 1
    if counter.add(5) != 17:
        return 2
    return 0
